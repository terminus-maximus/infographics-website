{
  "name": "~-documents-websites-terminusmaximus",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:replays": "node --experimental-strip-types --test scripts/replay-library.test.mjs",
    "prebuild": "node scripts/check-game-data.mjs && node scripts/check-heroes.mjs && node scripts/check-machines.mjs && node --test scripts/update-144.test.mjs && node scripts/check-raid-season.mjs",
    "check:raid-season": "node --test scripts/raid-season-source.test.mjs scripts/raid-season-guide.test.mjs && node scripts/check-raid-season.mjs",
    "build": "astro build",
    "import:heroes": "python3 scripts/hero-reference.py && python3 scripts/hero-profile-assets.py && python3 scripts/hero-round-portraits.py && python3 scripts/hero-relics.py && python3 scripts/import-heroes.py",
    "import:hero-relics": "python3 scripts/hero-relics.py",
    "import:machines": "python3 scripts/mow-reference.py",
    "check:update-144": "node --test scripts/update-144.test.mjs",
    "check:machines": "node --test scripts/machine-reference.test.mjs && node scripts/check-machines.mjs",
    "check:heroes": "node --test scripts/hero-scoring.test.mjs scripts/hero-reference.test.mjs scripts/hero-team-links.test.mjs scripts/hero-summaries.test.mjs scripts/hero-popularity.test.mjs && node scripts/check-heroes.mjs",
    "check:heroes:sources": "python3 scripts/import-heroes.py --check",
    "publish:heroes": "node scripts/publish-heroes.mjs",
    "import:lre": "node scripts/import-lre.mjs",
    "check:lre": "node scripts/check-lre.mjs",
    "check:guild-raid-next-season": "node scripts/check-guild-raid-next-season.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:campaign-events": "node scripts/check-campaign-events.mjs --built",
    "import:campaign-events": "python3 scripts/campaign-event-reference.py",
    "import:incursion-rules": "python3 scripts/incursion-reference.py",
    "check:game-data": "python3 scripts/test_incursion_reference.py && node scripts/check-game-data.mjs"
  },
  "dependencies": {
    "astro": "^6.4.2",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
