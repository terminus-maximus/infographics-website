---
import { heroes, heroById, heroHref } from '../../lib/heroes.mjs';
import roundPortraitSource from '../../lib/hero-round-portraits.mjs';
import type { HeroProfileGroup } from '../../lib/campaign-hero-profiles';
interface Props { groups?: HeroProfileGroup[]; orderNote?: string; }
const { groups, orderNote = 'Required heroes first, with the carry highlighted. Top supports lead the supporting options.' } = Astro.props;
const portraits: Record<string, { src: string }> = roundPortraitSource;
const profileGroups = groups?.map(group => ({ ...group, rows: group.rows.map(row => {
  const hero = heroById.get(row.heroId);
  const portrait = portraits[row.heroId];
  if (!hero || !portrait) throw new Error(`Missing campaign Hero Guide or portrait for ${row.heroId}`);
  return { ...row, hero, portrait, name: row.name || hero.name };
}) }));
const profileCount = profileGroups?.reduce((total, group) => total + group.rows.length, 0) || 0;
const path = Astro.url.pathname.replace(/\/+$/, '');
const related = groups ? [] : heroes.map(hero => ({hero, roles:[...new Set(hero.guides.filter(g => g.url.replace(/\/+$/, '') === path).map(g => g.role))]})).filter(row => row.roles.length);
---
{profileGroups && profileCount > 0 && <aside class="guide-hero-links campaign-profiles" id="hero-profiles" aria-labelledby="hero-profiles-heading">
  <header class="profiles-heading"><div><p class="profiles-eyebrow">Explore your heroes</p><h2 id="hero-profiles-heading">Hero Guides <span class="profile-count">{profileCount}</span></h2></div><a class="all-heroes" href="/heroes/">All Hero Guides <span aria-hidden="true">→</span></a></header>
  <p class="profiles-intro">Select a hero for stats, abilities, traits and ratings across game modes.</p>
  <p class="profiles-order">{orderNote}</p>
  <div class="profile-groups">{profileGroups.map(group => <details class="profile-group" open={!group.collapsed} data-profile-group={group.id}>
    <summary>{group.tier && <span class:list={['profile-tier', { 'top-tier': group.tier === 'S' }]}>{group.tier}</span>}<span class="profile-group-title">{group.title}</span><span class="group-count">{group.rows.length} heroes</span></summary>
    <ul class="profile-table">{group.rows.map(row => <li data-profile-hero={row.heroId}>
      <a class:list={['profile-row', { 'featured-profile': row.featured }]} href={heroHref(row.hero)} title={`${row.name} Hero Guide`} data-hero-guide-link>
        <img class="profile-portrait" src={row.portrait.src} alt="" width="48" height="48" loading="lazy" />
        <span class="profile-identity"><span class="profile-name">{row.name}</span>{row.context && <span class="profile-context">{row.context}</span>}</span>
        <span class="profile-role">{row.role}</span>
      </a>
    </li>)}</ul>
  </details>)}</div>
</aside>}
{related.length > 0 && <aside class="guide-hero-links" aria-label="Related hero profiles"><h2>Hero profiles</h2><p>Reference stats and mode ratings for the heroes linked to this guide. Reference links and requirement matches are not team recommendations.</p><details open={related.length <= 16}><summary>Browse {related.length} linked hero profiles</summary><ul>{related.map(({hero,roles}) => <li><a href={heroHref(hero)}>{hero.name}</a> <span>({roles.join(', ')})</span></li>)}</ul></details></aside>}
<style>
.guide-hero-links{max-width:1160px;margin:2rem auto;padding:1.25rem;border:1px solid #454035;border-radius:12px;background:#202020;color:#eee;font-family:Lexend,sans-serif}.guide-hero-links h2{color:#d4af37;font-size:1.35rem}.guide-hero-links p,.guide-hero-links span{color:#bcbcbc;font-size:.85rem}.guide-hero-links ul{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;padding-left:1.2rem}.guide-hero-links a{color:#efd579}.guide-hero-links li{font-size:.9rem}
.campaign-profiles { padding: 1.5rem; background: #1c1c1c; scroll-margin-top: 1rem; }
.campaign-profiles, .campaign-profiles * { box-sizing: border-box; }
.profiles-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
.campaign-profiles .profiles-eyebrow { margin: 0 0 .45rem; color: #a99458; font-size: .65rem; text-transform: uppercase; letter-spacing: .12em; }
.campaign-profiles h2 { display: flex; align-items: center; gap: .65rem; margin: 0; color: #e4c55e; font-size: 1.5rem; }
.campaign-profiles .profile-count { padding: .2rem .5rem; border: 1px solid #5c5030; border-radius: 6px; color: #dcc477; background: #29251b; font-size: .75rem; }
.campaign-profiles .all-heroes { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-size: .78rem; text-underline-offset: .2em; }
.campaign-profiles .all-heroes span { color: inherit; }
.campaign-profiles .profiles-intro { margin: 1rem 0 .3rem; font-size: .85rem; line-height: 1.65; }
.campaign-profiles .profiles-order { margin: 0 0 1.25rem; color: #999; font-size: .75rem; line-height: 1.65; }
.profile-group { border-top: 1px solid #3c3931; }
.profile-group summary { display: flex; align-items: center; gap: .65rem; min-height: 52px; padding: .75rem 0; cursor: pointer; list-style: none; }
.profile-group summary::-webkit-details-marker { display: none; }
.profile-group summary::after { content: '+'; margin-left: auto; color: #d8bf76; font-size: 1.1rem; }
.profile-group[open] summary::after { content: '−'; }
.campaign-profiles .profile-group-title { color: #e5dfcf; font-size: .85rem; font-weight: 600; }
.campaign-profiles .group-count { color: #999; font-size: .68rem; white-space: nowrap; }
.campaign-profiles .profile-tier { display: grid; place-items: center; flex-shrink: 0; width: 1.8rem; height: 1.8rem; border: 1px solid #5a5037; border-radius: 5px; color: #dcc477; background: #29251c; font-size: .8rem; }
.campaign-profiles .top-tier { color: #f5d77e; border-color: #8a7138; }
.campaign-profiles .profile-table { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; margin: 0 0 1rem; padding: 0; list-style: none; }
.profile-table li { min-width: 0; }
.campaign-profiles .profile-row { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: .75rem; height: 100%; min-height: 72px; padding: .65rem .5rem; border-bottom: 1px solid #323232; border-radius: 5px; text-decoration: none; box-sizing: border-box; }
.profile-portrait { display: block; width: 48px; height: 48px; object-fit: contain; border-radius: 50%; border: 1px solid #555; background: #252525; }
.profile-identity { min-width: 0; }
.campaign-profiles .profile-name { display: block; color: #e4c55e; font-size: .84rem; line-height: 1.5; text-decoration: underline; text-decoration-color: #736134; text-underline-offset: .2em; }
.campaign-profiles .profile-context { display: block; margin-top: .2rem; color: #999; font-size: .68rem; line-height: 1.4; }
.campaign-profiles .profile-role { max-width: 7rem; padding: .3rem .5rem; border: 1px solid #414141; border-radius: 5px; color: #bbb; background: #242424; font-size: .65rem; line-height: 1.5; text-align: center; }
.campaign-profiles .featured-profile .profile-role { color: #edd383; border-color: #685930; background: #2c271b; }
.profile-row:hover { background: #252219; }
.campaign-profiles .profile-row:hover .profile-name { color: #ffe39a; }
.profile-row:hover .profile-portrait { border-color: #d4af37; }
.campaign-profiles :is(a, summary):focus-visible { outline: 2px solid #e4c55e; outline-offset: 3px; }
@media (max-width: 900px) { .campaign-profiles .profile-table { grid-template-columns: 1fr; } }
@media (max-width: 500px) {
  .campaign-profiles { padding: 1rem; }
  .profiles-heading { gap: .25rem; }
  .campaign-profiles .profile-row { grid-template-columns: 44px minmax(0, 1fr); gap: .25rem .65rem; padding: .7rem .25rem; }
  .profile-portrait { grid-row: 1 / 3; width: 44px; height: 44px; }
  .campaign-profiles .profile-role { grid-column: 2; justify-self: start; max-width: none; padding: .15rem .4rem; }
  .campaign-profiles .group-count { margin-left: auto; }
  .profile-group summary { flex-wrap: wrap; gap: .5rem; }
  .profile-group summary::after { margin-left: 0; }
}
</style>
