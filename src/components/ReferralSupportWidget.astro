<aside
  class="referral-widget"
  data-referral-widget
  aria-label="Tacticus referral support"
  hidden
>
  <button
    class="referral-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="referral-support-card"
    data-referral-trigger
  >
    <img src="/images/blackstone.webp" alt="Blackstone" width="30" height="30" />
    <span>Get 100 Blackstone</span>
    <span class="referral-trigger-icon" aria-hidden="true">+</span>
  </button>

  <section class="referral-card" id="referral-support-card" data-referral-card hidden>
    <div class="referral-card-header">
      <img src="/images/blackstone.webp" alt="" width="42" height="42" />
      <h2>Support Terminus Maximus <span>Get 100 Blackstone</span></h2>
      <button
        class="referral-close"
        type="button"
        aria-label="Collapse referral instructions"
        data-referral-close
      >
        <span aria-hidden="true">−</span>
      </button>
    </div>

    <ol class="referral-steps">
      <li><span aria-hidden="true">🌐</span><span>Go to the Home Menu</span></li>
      <li><span aria-hidden="true">⚙️</span><span>Find the Gear icon → open Settings</span></li>
      <li><span aria-hidden="true">🟢</span><span>Press <strong>REFER A FRIEND</strong></span></li>
    </ol>

    <p class="referral-code-label">Referral Code</p>
    <button class="referral-copy" type="button" data-referral-copy aria-describedby="referral-copy-status">
      <strong>CRY-44-LID</strong>
      <span data-referral-copy-label>Copy Code</span>
    </button>
    <p class="referral-copy-status" id="referral-copy-status" aria-live="polite" data-referral-copy-status></p>
    <button class="referral-dismiss" type="button" data-referral-dismiss>
      Don’t show this again
    </button>
  </section>
</aside>

<script>
  import {
    REFERRAL_DISMISSED_KEY,
    REFERRAL_ENTRANCE_KEY,
    isHighIntentReferralPath,
    recordReferralPageview,
  } from "../lib/referralWidget";

  const REFERRAL_CODE = "CRY-44-LID";

  type Gtag = (command: "event", eventName: string, parameters: Record<string, string>) => void;

  const widget = document.querySelector<HTMLElement>("[data-referral-widget]");

  if (widget && widget.dataset.initialized !== "true") {
    widget.dataset.initialized = "true";

    let pageviewCount = 1;
    let shouldAnimate = true;
    let permanentlyDismissed = false;

    try {
      permanentlyDismissed = localStorage.getItem(REFERRAL_DISMISSED_KEY) !== null;
    } catch {
      // Local storage can be unavailable in privacy-restricted browsing contexts.
    }

    if (!permanentlyDismissed) {
      try {
        pageviewCount = recordReferralPageview(window.sessionStorage);
        shouldAnimate = sessionStorage.getItem(REFERRAL_ENTRANCE_KEY) !== "true";
      } catch {
        // Session storage can be unavailable in privacy-restricted browsing contexts.
      }
    }

    const eligible = !permanentlyDismissed && (
      isHighIntentReferralPath(window.location.pathname) || pageviewCount >= 2
    );

    if (eligible) {
      widget.hidden = false;
      widget.classList.add("is-visible");

      if (shouldAnimate) {
        widget.classList.add("is-entering");

        try {
          sessionStorage.setItem(REFERRAL_ENTRANCE_KEY, "true");
        } catch {
          // The widget remains usable when session storage is unavailable.
        }
      }

      const browserWindow = window as typeof window & { gtag?: Gtag };
      browserWindow.gtag?.("event", "referral_widget_impression", {
        page_path: window.location.pathname,
        page_title: document.title,
      });
    }

    const trigger = widget.querySelector<HTMLButtonElement>("[data-referral-trigger]");
    const card = widget.querySelector<HTMLElement>("[data-referral-card]");
    const closeButton = widget.querySelector<HTMLButtonElement>("[data-referral-close]");
    const copyButton = widget.querySelector<HTMLButtonElement>("[data-referral-copy]");
    const copyLabel = widget.querySelector<HTMLElement>("[data-referral-copy-label]");
    const copyStatus = widget.querySelector<HTMLElement>("[data-referral-copy-status]");
    const dismissButton = widget.querySelector<HTMLButtonElement>("[data-referral-dismiss]");
    let copyResetTimer: number | undefined;

    const track = (eventName: string) => {
      const browserWindow = window as typeof window & { gtag?: Gtag };
      browserWindow.gtag?.("event", eventName, {
        page_path: window.location.pathname,
        page_title: document.title,
      });
    };

    const collapse = (restoreFocus = false) => {
      if (!trigger || !card) return;

      trigger.hidden = false;
      trigger.setAttribute("aria-expanded", "false");
      card.hidden = true;

      if (restoreFocus) trigger.focus();
    };

    trigger?.addEventListener("click", () => {
      if (!card) return;

      trigger.hidden = true;
      trigger.setAttribute("aria-expanded", "true");
      card.hidden = false;
      closeButton?.focus();
      track("referral_widget_expand");
    });

    closeButton?.addEventListener("click", () => collapse(true));

    dismissButton?.addEventListener("click", () => {
      try {
        localStorage.setItem(REFERRAL_DISMISSED_KEY, "true");
      } catch {
        // Still honor the visitor's choice for the current page if persistence is unavailable.
      }

      track("referral_widget_dismiss");
      widget.hidden = true;
    });

    widget.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && card?.hidden === false) collapse(true);
    });

    copyButton?.addEventListener("click", async () => {
      let copied = false;

      try {
        await navigator.clipboard.writeText(REFERRAL_CODE);
        copied = true;
      } catch {
        // Clipboard access requires a secure context and can be denied by the browser.
      }

      if (!copied) return;

      if (copyLabel) copyLabel.textContent = "Copied!";
      if (copyStatus) copyStatus.textContent = "Referral code copied.";
      track("referral_code_copy");

      window.clearTimeout(copyResetTimer);
      copyResetTimer = window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = "Copy Code";
        if (copyStatus) copyStatus.textContent = "";
      }, 2000);
    });
  }
</script>

<style>
  .referral-widget {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 900;
    max-width: calc(100vw - 2rem);
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
  }

  .referral-widget[hidden],
  .referral-trigger[hidden],
  .referral-card[hidden] {
    display: none;
  }

  .referral-widget.is-entering {
    animation: referral-enter 360ms ease-out both;
  }

  .referral-trigger,
  .referral-card {
    border: 1px solid #d4af37;
    border-radius: 12px;
    background: #1e1e1e;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.5);
  }

  .referral-trigger {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.75rem;
    color: #f5f5f5;
    cursor: pointer;
    font: 600 0.9rem/1.2 'Lexend', sans-serif;
  }

  .referral-trigger:hover,
  .referral-trigger:focus-visible,
  .referral-close:hover,
  .referral-close:focus-visible,
  .referral-copy:hover,
  .referral-copy:focus-visible,
  .referral-dismiss:focus-visible {
    border-color: #efd46d;
    outline: 2px solid transparent;
    color: #efd46d;
  }

  .referral-trigger img,
  .referral-card-header img {
    display: block;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .referral-trigger-icon {
    color: #d4af37;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
  }

  .referral-card {
    box-sizing: border-box;
    width: min(22rem, calc(100vw - 2rem));
    padding: 1rem;
  }

  .referral-card-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7rem;
  }

  .referral-card h2 {
    margin: 0;
    color: #d4af37;
    font-size: 1rem;
    line-height: 1.3;
  }

  .referral-card h2 span {
    display: block;
    color: #f5f5f5;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .referral-close {
    width: 44px;
    height: 44px;
    border: 1px solid #444;
    border-radius: 9px;
    background: #252525;
    color: #d4af37;
    cursor: pointer;
    font: 500 1.5rem/1 'Lexend', sans-serif;
  }

  .referral-steps {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
    font-size: 0.83rem;
    line-height: 1.4;
  }

  .referral-steps li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.4rem;
  }

  .referral-code-label {
    margin: 0 0 0.35rem;
    color: #aaa;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .referral-copy {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid #555;
    border-radius: 9px;
    padding: 0.65rem 0.75rem;
    background: #252525;
    color: #f5f5f5;
    cursor: pointer;
    font-family: 'Lexend', sans-serif;
  }

  .referral-copy strong {
    color: #efd46d;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .referral-copy span {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .referral-copy-status {
    min-height: 1em;
    margin: 0.35rem 0 0;
    color: #b9d88a;
    font-size: 0.7rem;
    text-align: right;
  }

  .referral-dismiss {
    display: block;
    min-height: 44px;
    margin: 0.1rem auto -0.35rem;
    border: 0;
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
    background: transparent;
    color: #888;
    cursor: pointer;
    font: 400 0.72rem/1.3 'Lexend', sans-serif;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .referral-dismiss:hover {
    color: #bbb;
  }

  @keyframes referral-enter {
    from {
      opacity: 0;
      transform: translateY(0.65rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .referral-widget {
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      max-width: calc(100vw - 1.5rem);
    }

    .referral-trigger {
      gap: 0.4rem;
      min-height: 44px;
      padding: 0.4rem 0.6rem;
      font-size: 0.78rem;
    }

    .referral-trigger img {
      width: 25px;
      height: 25px;
    }

    .referral-card {
      width: min(22rem, calc(100vw - 1.5rem));
      padding: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .referral-widget.is-entering {
      animation: none;
    }
  }
</style>
