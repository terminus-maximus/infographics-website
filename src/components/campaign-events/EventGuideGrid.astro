---
import { campaignEventCatalog, factionIcons } from '../../data/campaign-events/catalog';
import { campaignEvents, eventCharacters } from '../../lib/campaign-events';
interface Props { exclude?: string; }
const { exclude } = Astro.props;
---
<div class="event-grid">
  {campaignEventCatalog.filter(event => event.slug !== exclude).map(event => {
    const guide = campaignEvents.find(guide => guide.slug === event.slug)!;
    return <a class="event-card" href={`/campaign-event/${event.slug}/`}>
      <img class="preview" src={`/images/thumbnails/ce-${event.slug}-thumb.png`} alt={`${event.name} Campaign Event infographic preview`} width="400" height="225" loading="lazy" />
      <div class="card-body"><h3><img src={`/images/factions/${event.icon}.png`} alt="" width="34" height="34" loading="lazy" />{event.name}<span aria-hidden="true">↗</span></h3>
      <p>{event.description}</p>
      <div class="required-label">Required trio</div><div class="required-trio">{guide.requiredHeroIds.map(id => <div><img src={eventCharacters[id].portrait} alt="" width="44" height="44" loading="lazy" /><span>{eventCharacters[id].name}</span></div>)}</div>
      <div class="factions">{event.factions.map(faction => <span><img src={`/images/factions/${factionIcons[faction]}.png`} alt="" width="22" height="22" loading="lazy" />{faction}</span>)}</div>
      </div>
    </a>;
  })}
</div>
<style>
  .event-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .event-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #414141; border-radius: 12px; background: #1e1e1e; text-decoration: none; color: inherit; transition: border-color .2s, transform .2s; }
  .event-card:hover, .event-card:focus-visible { border-color: #d4af37; transform: translateY(-3px); }
  .preview { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; background: #121212; border-bottom: 1px solid #414141; }
  .card-body { padding: 1.15rem; display: flex; flex-direction: column; flex: 1; }
  h3 { display: flex; align-items: center; gap: .5rem; color: #e4c55e; margin: 0; font-size: 1.2rem; }
  h3 span { margin-left: auto; font-size: 1rem; }
  h3 img, .factions img { object-fit: contain; }
  p { color: #bbb; font-size: .8rem; line-height: 1.65; margin: .65rem 0 1rem; }
  .required-label { color: #aaa; text-transform: uppercase; font-size: .6rem; letter-spacing: .08em; margin-top: auto; margin-bottom: .7rem; }
  .required-trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
  .required-trio > div { display: grid; justify-items: center; gap: .35rem; text-align: center; }
  .required-trio img { border: 1px solid #555; background: #252525; border-radius: 50%; }
  .required-trio span { font-size: .66rem; color: #eee; }
  .factions { display: flex; gap: .35rem .75rem; flex-wrap: wrap; margin-top: 1rem; padding-top: .8rem; border-top: 1px solid #353535; }
  .factions span { display: flex; align-items: center; gap: .35rem; color: #aaa; font-size: .65rem; }
  @media (max-width: 1000px) { .event-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .event-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .event-card { transition: none; transform: none !important; } }
</style>
