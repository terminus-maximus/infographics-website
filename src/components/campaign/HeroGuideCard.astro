---
import type { CharacterReference, RankReference } from "../../lib/campaigns";
import type { HeroGuide } from "../../data/campaigns/indomitusGuideContent";

interface Props {
  guide: HeroGuide;
  character: CharacterReference;
  ranks: Record<string, RankReference>;
}

const { guide, character, ranks } = Astro.props;
const abilityIcon = (ability: "Active" | "Passive") =>
  `/images/abilities/${guide.abilityTargets?.iconName}-${ability}.webp`;
---

<article class:list={["hero-guide-card", { featured: guide.featured }]}>
  <header>
    <img src={character.portrait} alt={`${character.name} portrait`} width="72" height="72" loading="lazy" />
    <div>
      <h3>{guide.heading}</h3>
      <p class="role"><strong>Role:</strong> {guide.role}</p>
    </div>
  </header>

  <p class="hero-callout">{guide.callout}</p>

  {guide.rankTargets && guide.abilityTargets && (
    <dl class="recommendations" aria-label={`${guide.heading} recommended investment`}>
      <div class="recommendation-card">
        <dt>Rank</dt>
        <dd class="target-list">
          {(["normal", "elite"] as const).map((mode) => {
            const rank = ranks[guide.rankTargets![mode]];
            return (
              <span class="target-row">
                <span>{mode === "normal" ? "Normal" : "Elite"}</span>
                <img class="rank-icon" src={rank.badge} alt={`${rank.name} rank`} title={rank.name} width="44" height="44" loading="lazy" />
              </span>
            );
          })}
        </dd>
      </div>

      {(["active", "passive"] as const).map((ability) => {
        const abilityLabel = ability === "active" ? "Active" : "Passive";
        const targets = guide.abilityTargets![ability];
        return (
          <div class="recommendation-card">
            <dt class="ability-title">
              <img src={abilityIcon(abilityLabel)} alt="" width="40" height="40" loading="lazy" />
              <span>{abilityLabel}</span>
            </dt>
            <dd class="target-list">
              <span class="target-row"><span>Normal</span><strong>{targets.normal}</strong></span>
              <span class="target-row"><span>Elite</span><strong>{targets.elite}</strong></span>
            </dd>
          </div>
        );
      })}
    </dl>
  )}

  <div class="hero-copy">
    {guide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

</article>

<style>
  .hero-guide-card {
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: 1.15rem;
    border: 1px solid #333;
    border-radius: 9px;
    background: #121212;
  }

  .hero-guide-card.featured {
    border-color: #5b4b1c;
  }

  header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  header img {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid #444;
    border-radius: 50%;
    background: #1e1e1e;
    object-fit: cover;
  }

  h3 {
    margin: 0 0 0.3rem;
    color: #f5f5f5;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: #bdbdbd;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .role strong {
    color: #d4af37;
  }

  .recommendations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
  }

  .recommendation-card {
    padding: 0.65rem 0.75rem;
    border: 1px solid #2f2f2f;
    border-radius: 7px;
    background: #181818;
  }

  dt {
    margin-bottom: 0.15rem;
    color: #d4af37;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ability-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ability-title img {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #444;
    border-radius: 8px;
    object-fit: cover;
  }

  dd {
    margin: 0;
    color: #d5d5d5;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .target-list {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }

  .target-row {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .target-row > span:first-child {
    color: #999;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .target-row strong {
    color: #f5f5f5;
    font-size: 1rem;
  }

  .rank-icon {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
  }

  .hero-copy {
    display: grid;
    gap: 0.7rem;
  }

  .hero-callout {
    padding: 0.75rem 0.85rem;
    border-left: 3px solid #d4af37;
    border-radius: 0 7px 7px 0;
    background: rgba(212, 175, 55, 0.08);
    color: #f5d76e;
    font-weight: 800;
  }

  @media (max-width: 700px) {
    .hero-guide-card {
      padding: 0.9rem;
    }

    header img {
      width: 3.5rem;
      height: 3.5rem;
    }

    .recommendations {
      grid-template-columns: 1fr;
    }
  }
</style>
