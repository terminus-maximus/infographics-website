---
import type { CharacterReference } from "../../lib/campaigns";
import type { HeroGuide } from "../../data/campaigns/indomitusGuideContent";

interface Props {
  guide: HeroGuide;
  character: CharacterReference;
}

const { guide, character } = Astro.props;
---

<article class:list={["hero-guide-card", { featured: guide.featured }]}>
  <header>
    <img src={character.portrait} alt={`${character.name} portrait`} width="72" height="72" loading="lazy" />
    <div>
      <h3>{guide.heading}</h3>
      <p class="role"><strong>Role:</strong> {guide.role}</p>
    </div>
  </header>

  <p class="hero-callout">{guide.callout}</p>

  {guide.recommendations && (
    <dl class="recommendations" aria-label={`${guide.heading} recommended investment`}>
      {guide.recommendations.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )}

  <div class="hero-copy">
    {guide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

</article>

<style>
  .hero-guide-card {
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: 1.15rem;
    border: 1px solid #333;
    border-radius: 9px;
    background: #121212;
  }

  .hero-guide-card.featured {
    border-color: #5b4b1c;
  }

  header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  header img {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid #444;
    border-radius: 50%;
    background: #1e1e1e;
    object-fit: cover;
  }

  h3 {
    margin: 0 0 0.3rem;
    color: #f5f5f5;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: #bdbdbd;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .role strong {
    color: #d4af37;
  }

  .recommendations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
  }

  .recommendations > div {
    padding: 0.65rem 0.75rem;
    border: 1px solid #2f2f2f;
    border-radius: 7px;
    background: #181818;
  }

  dt {
    margin-bottom: 0.15rem;
    color: #d4af37;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: #d5d5d5;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .hero-copy {
    display: grid;
    gap: 0.7rem;
  }

  .hero-callout {
    padding: 0.75rem 0.85rem;
    border-left: 3px solid #d4af37;
    border-radius: 0 7px 7px 0;
    background: rgba(212, 175, 55, 0.08);
    color: #f5d76e;
    font-weight: 800;
  }

  @media (max-width: 700px) {
    .hero-guide-card {
      padding: 0.9rem;
    }

    header img {
      width: 3.5rem;
      height: 3.5rem;
    }

    .recommendations {
      grid-template-columns: 1fr;
    }
  }
</style>
