---
import RankBadge from "./RankBadge.astro";
import type { CharacterReference, RankReference } from "../../lib/campaigns";

interface Props {
  character: CharacterReference;
  rank: RankReference;
  energy: number;
  highlighted?: boolean;
}

const { character, rank, energy, highlighted = false } = Astro.props;
---

<div class:list={["character-rank", { highlighted }]} data-character-energy={energy}>
  <strong class="character-name">{character.shortName}</strong>
  <div class="icon-row">
    <img
      class="portrait"
      src={character.portrait}
      alt={`${character.name} portrait`}
      width="64"
      height="64"
      loading="lazy"
    />
    <RankBadge rank={rank} showLabel={false} />
  </div>
  <div class="character-energy" aria-label={`${energy.toLocaleString("en-US")} Energy`}>
    <img src="/images/ranks/energy.webp" alt="" width="20" height="20" loading="lazy" />
    <span>{energy.toLocaleString("en-US")}</span>
  </div>
</div>

<style>
  .character-rank {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    min-width: 7.75rem;
    padding: 0.65rem;
    border: 1px solid #333;
    border-radius: 8px;
    background: #1e1e1e;
  }

  .character-name {
    width: 100%;
    color: #f5f5f5;
    font-size: 0.8rem;
    text-align: center;
  }

  .icon-row {
    display: grid;
    grid-template-columns: repeat(2, 3.25rem);
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .character-rank.highlighted {
    border-color: #d4af37;
    box-shadow: 0 0 0 1px rgb(212 175 55 / 28%);
  }

  .portrait {
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid #333;
    border-radius: 50%;
    background: #121212;
    object-fit: cover;
  }

  .character-energy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    color: #cccccc;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .character-energy img {
    width: 1.15rem;
    height: 1.15rem;
    object-fit: contain;
  }
</style>
