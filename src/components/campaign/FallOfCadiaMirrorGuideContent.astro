---
import type { CampaignMode, CampaignVideo, CharacterReference, RankReference } from "../../lib/campaigns";
import {
  bestSupportingHero,
  bossContent,
  difficultStageGroups,
  overviewContent,
  requiredHeroContent,
  supportingHeroGroups,
} from "../../data/campaigns/fallOfCadiaMirrorGuideContent";
import { getFallOfCadiaMirrorEquipmentRecommendation } from "../../data/campaigns/equipmentRecommendations";
import EquipmentBadge from "./EquipmentBadge.astro";
import HeroGuideCard from "./HeroGuideCard.astro";
import StageReplayPreview from "./StageReplayPreview.astro";

interface Props {
  characters: Record<string, CharacterReference>;
  modes: CampaignMode[];
  videos: Record<string, CampaignVideo>;
  ranks: Record<string, RankReference>;
}

const { characters, modes, videos, ranks } = Astro.props;
const findMode = (modeId: string) => modes.find((mode) => mode.id === modeId)!;
const findStage = (modeId: string, stageNumber: number) =>
  findMode(modeId).stages.find((stage) => stage.number === stageNumber);

const tocGroups = [
  { title: "Guide", links: [["Overview", "#overview"], ["Required Heroes", "#required-heroes"], ["Supporting Heroes", "#supporting-heroes"], ["Difficult Stages", "#difficult-stages"]] },
  { title: "Supporting Heroes", links: [["Best — Isabella", "#best-supporting-hero"], ["Campaign Comrades", "#campaign-comrades"], ["Elite Heroes", "#elite-heroes"]] },
  { title: "Difficult Stages", links: [["Normal", "#difficult-normal-stages"], ["Elite", "#difficult-elite-stages"], ["Bosses", "#campaign-bosses"]] },
  { title: "Replay Data", links: [["Replay Filters", "#campaign-replay-filters"], ["Campaign Replays", "#campaign-replays"], ["Replay Statistics", "#campaign-replay-statistics"], ["Related Guides", "#related-guides"]] },
];
---

<nav class="table-of-contents guide-panel" aria-labelledby="table-of-contents-heading">
  <h2 id="table-of-contents-heading">Table of Contents</h2>
  <div class="toc-grid">
    {tocGroups.map((group) => (
      <div class="toc-group">
        <h3>{group.title}</h3>
        <ul>{group.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
    ))}
  </div>
</nav>

<section class="guide-panel" id="overview" aria-labelledby="overview-heading">
  <h2 id="overview-heading">Overview</h2>
  <div class="overview-grid">
    <article class="overview-card">
      <span class="section-icon" aria-hidden="true">◷</span>
      <div>
        <h3>Timing</h3>
        <p class="content-callout">{overviewContent.timing.callout}</p>
        <div class="copy-stack">{overviewContent.timing.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
    </article>

    <article class="overview-card">
      <span class="section-icon" aria-hidden="true">↗</span>
      <div>
        <h3>Progression</h3>
        <p class="content-callout">{overviewContent.progression.callout}</p>
        <p>{overviewContent.progression.introduction}</p>
        <ol>{overviewContent.progression.steps.map((step) => <li>{step}</li>)}</ol>
        <div class="copy-stack">{overviewContent.progression.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
    </article>

    <article class="overview-card investment-card">
      <span class="section-icon" aria-hidden="true">◆</span>
      <div>
        <h3>Recommended Investment</h3>
        {(["normal", "elite"] as const).map((mode) => (
          <>
            <h4>{mode === "normal" ? "Normal" : "Elite"} Investment</h4>
            <div class="table-scroll" tabindex="0" aria-label={`${mode} investment recommendations`}>
              <table>
                <thead><tr><th>Hero</th><th>Rank</th><th>Active</th><th>Passive</th><th>Weapon</th><th>Defense</th></tr></thead>
                <tbody>{overviewContent[mode === "normal" ? "normalInvestment" : "eliteInvestment"].map((row) => {
                  const character = characters[row.characterId];
                  const rank = ranks[row.rankId];
                  const equipment = getFallOfCadiaMirrorEquipmentRecommendation(row.abilityIconName)[mode];
                  return (
                    <tr>
                      <td><img class="table-hero" src={character.portrait} alt={character.name} title={character.name} width="42" height="42" loading="lazy" /></td>
                      <td><img class="table-rank-icon" src={rank.badge} alt={`${rank.name} rank`} title={rank.name} width="42" height="42" loading="lazy" /></td>
                      <td><span class="table-ability"><img src={`/images/abilities/${row.abilityIconName}-Active.webp`} alt={`${character.shortName} active ability`} width="38" height="38" loading="lazy" /><strong>{row.active}</strong></span></td>
                      <td><span class="table-ability"><img src={`/images/abilities/${row.abilityIconName}-Passive.webp`} alt={`${character.shortName} passive ability`} width="38" height="38" loading="lazy" /><strong>{row.passive}</strong></span></td>
                      <td><span class="table-equipment"><EquipmentBadge equipment={equipment.weapon} size={42} /><strong>{equipment.weapon.rank}</strong></span></td>
                      <td><span class="table-equipment"><EquipmentBadge equipment={equipment.defense} size={42} /><strong>{equipment.defense.rank}</strong></span></td>
                    </tr>
                  );
                })}</tbody>
              </table>
            </div>
          </>
        ))}
      </div>
    </article>

    <article class="overview-card strategy-card">
      <span class="section-icon" aria-hidden="true">✦</span>
      <div>
        <h3>Strategy &amp; Tips</h3>
        <div class="tip-list">
          {overviewContent.strategyTips.map(([title, copy]) => <section class="tip-card"><h4>{title}</h4><p>{copy}</p></section>)}
        </div>
      </div>
    </article>
  </div>
</section>

<section class="guide-panel" id="required-heroes" aria-labelledby="required-heroes-heading">
  <h2 id="required-heroes-heading">Required Heroes</h2>
  <p class="section-intro">Kut Skoden, Sibyll Devine, and Thaddeus Noble are mandatory throughout Fall of Cadia Mirror. Elite 2, 12, 29, and 36 restrict deployment to this trio, making focused required-hero investment essential.</p>
  <div class="hero-grid required-grid">
    {requiredHeroContent.map((guide) => (
      <HeroGuideCard guide={guide} character={characters[guide.characterId]} ranks={ranks} equipment={getFallOfCadiaMirrorEquipmentRecommendation(guide.abilityTargets!.iconName)} />
    ))}
  </div>
</section>

<section class="guide-panel" id="supporting-heroes" aria-labelledby="supporting-heroes-heading">
  <h2 id="supporting-heroes-heading">Supporting Heroes</h2>
  <p class="section-intro">Supporting heroes dramatically reduce the difficulty of open-deployment stages, but they do not replace Kut, Sibyll, and Thaddeus on restricted Elite battles.</p>

  <section class="best-support" id="best-supporting-hero" aria-labelledby="best-supporting-hero-heading">
    <h3 id="best-supporting-hero-heading" class="bucket-heading">Best</h3>
    <HeroGuideCard guide={bestSupportingHero} character={characters[bestSupportingHero.characterId]} ranks={ranks} />
  </section>

  <div class="disclosure-stack">
    {supportingHeroGroups.map((group) => (
      <details class="guide-disclosure" id={group.id}>
        <summary>
          <span>{group.title}</span>
          <span class="summary-portraits" aria-hidden="true">{group.heroes.map((guide) => <img src={characters[guide.characterId].portrait} alt="" width="34" height="34" loading="lazy" />)}</span>
        </summary>
        <div class="disclosure-content hero-grid">{group.heroes.map((guide) => <HeroGuideCard guide={guide} character={characters[guide.characterId]} ranks={ranks} />)}</div>
      </details>
    ))}
  </div>
</section>

<section class="guide-panel" id="difficult-stages" aria-labelledby="difficult-stages-heading">
  <h2 id="difficult-stages-heading">Difficult Stages</h2>
  <p class="section-intro">Deployment restrictions define the most important Fall of Cadia Mirror gates. Replay ranks vary widely, so use low-investment clears as proof of possibility—not as a universal beginner baseline.</p>
  <div class="disclosure-stack">
    {difficultStageGroups.map((group) => (
      <details class="guide-disclosure" id={group.id}>
        <summary>{group.title}</summary>
        <div class="disclosure-content stage-grid">
          {group.stages.map((stage) => {
            const replayStage = findStage(group.modeId, stage.number);
            return <article class="stage-card">
              <span class="stage-number">{stage.number}</span>
              <div>
                <h3>{group.title} {stage.number} — {stage.title}</h3>
                <h4>Why players struggle</h4><p>{stage.why}</p>
                <h4>Strategy</h4><ul>{stage.strategy.map((item) => <li>{item}</li>)}</ul>
                <h4>Closing note</h4><p>{stage.closing}</p>
                {replayStage ? (
                  <StageReplayPreview mode={findMode(group.modeId)} stage={replayStage} videos={videos} characters={characters} ranks={ranks} />
                ) : (
                  <p class="replay-gap">No dedicated replay row is available for this stage yet. Use the campaign filters and the trio formation principles above.</p>
                )}
              </div>
            </article>;
          })}
        </div>
      </details>
    ))}

    <details class="guide-disclosure" id="campaign-bosses">
      <summary>Bosses</summary>
      <div class="disclosure-content boss-content">
        <p class="boss-intro">Fall of Cadia Mirror bosses appear at Normal 15, 30, 45, 60, and 75, with their Elite encounters at 8, 16, 24, 32, and 40.</p>
        <div class="boss-grid">
          {bossContent.map((boss) => {
            const character = characters[boss.characterId];
            return <article class="boss-card"><img src={character.portrait} alt={`${character.name} portrait`} width="64" height="64" loading="lazy" /><div><h3>{boss.heading}</h3><div class="appearance-list">{boss.appearances.map((appearance) => <span>{appearance}</span>)}</div><div class="copy-stack">{boss.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div></article>;
          })}
        </div>
      </div>
    </details>
  </div>
</section>

<style>
  .guide-panel { margin-bottom: 3rem; padding: 1.5rem; scroll-margin-top: 6rem; border: 1px solid #333; border-radius: 12px; background: #1e1e1e; }
  h2 { margin: 0 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #333; color: #d4af37; }
  h3 { margin: 0 0 0.35rem; color: #f5f5f5; font-size: 1rem; line-height: 1.3; }
  h4 { margin: 1rem 0 0.4rem; color: #d4af37; font-size: 0.88rem; line-height: 1.35; }
  p { margin: 0; color: #bdbdbd; font-size: 0.92rem; line-height: 1.65; }
  ol, ul { margin: 0.7rem 0; padding-left: 1.35rem; color: #c7c7c7; font-size: 0.9rem; line-height: 1.65; }
  li + li { margin-top: 0.3rem; }
  .section-intro { margin: -0.15rem 0 1.25rem; }
  .toc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .toc-group { padding: 1rem; border: 1px solid #333; border-radius: 8px; background: #121212; }
  .toc-group ul { margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .toc-group li + li { margin-top: 0.35rem; }
  a { color: #d4af37; font-weight: 700; text-decoration: none; }
  a:hover, a:focus-visible { color: #f5d76e; text-decoration: underline; outline: none; }
  .overview-grid { display: grid; gap: 1rem; }
  .overview-card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; padding: 1.15rem; border: 1px solid #333; border-radius: 9px; background: #121212; }
  .section-icon { display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border: 1px solid #5b4b1c; border-radius: 50%; background: rgba(212,175,55,.08); color: #d4af37; font-weight: 800; }
  .content-callout { margin: 0.25rem 0 0.8rem; padding: 0.75rem 0.85rem; border-left: 3px solid #d4af37; border-radius: 0 7px 7px 0; background: rgba(212,175,55,.08); color: #f5d76e; font-weight: 800; }
  .copy-stack { display: grid; gap: 0.7rem; }
  .tip-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .tip-card { padding: 0.85rem; border: 1px solid #2f2f2f; border-radius: 7px; background: #181818; }
  .tip-card h4 { margin-top: 0; }
  .hero-grid { display: grid; gap: 1rem; }
  .required-grid { grid-template-columns: 1fr; }
  .best-support { margin-bottom: 1rem; scroll-margin-top: 6rem; }
  .bucket-heading { margin-bottom: 0.65rem; color: #d4af37; font-size: 1.08rem; }
  .disclosure-stack { display: grid; gap: 0.8rem; }
  .guide-disclosure { scroll-margin-top: 6rem; border: 1px solid #333; border-radius: 9px; background: #121212; }
  summary { display: flex; min-height: 3.5rem; align-items: center; justify-content: flex-start; gap: 1rem; padding: 0.85rem 1rem; color: #d4af37; cursor: pointer; font-weight: 800; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { color: #f59e0b; content: "+"; font-size: 1.35rem; line-height: 1; }
  .guide-disclosure[open] summary::after { content: "−"; }
  summary:hover, summary:focus-visible { color: #f5d76e; outline: none; }
  .summary-portraits { display: flex; flex-wrap: wrap; justify-content: flex-end; margin-left: auto; }
  .summary-portraits img { width: 2.1rem; height: 2.1rem; margin-left: -0.25rem; border: 1px solid #444; border-radius: 50%; background: #1e1e1e; object-fit: cover; }
  .disclosure-content { padding: 0 1rem 1rem; }
  .stage-grid, .boss-grid { display: grid; gap: 1rem; }
  .stage-card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; padding: 1rem; border: 1px solid #333; border-radius: 8px; background: #181818; }
  .stage-number { display: grid; width: 2.7rem; height: 2.7rem; place-items: center; border: 1px solid #5b4b1c; border-radius: 50%; color: #f5d76e; font-weight: 900; }
  .boss-intro { margin-bottom: 1rem; }
  .boss-card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; padding: 1rem; border: 1px solid #333; border-radius: 8px; background: #181818; }
  .boss-card > img { border: 1px solid #444; border-radius: 50%; object-fit: cover; }
  .appearance-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.4rem 0 0.7rem; }
  .appearance-list span { padding: 0.2rem 0.5rem; border: 1px solid #4b421f; border-radius: 999px; color: #d8c575; font-size: 0.72rem; font-weight: 800; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; min-width: 680px; border-collapse: collapse; color: #d5d5d5; font-size: 0.82rem; }
  th, td { padding: 0.65rem; border: 1px solid #333; text-align: center; }
  thead th { background: #181818; color: #d4af37; }
  tbody th { color: #f5d76e; text-align: left; }
  .table-hero { width: 2.65rem; height: 2.65rem; border: 1px solid #444; border-radius: 50%; object-fit: cover; }
  .table-rank-icon { width: 2.65rem; height: 2.65rem; object-fit: contain; }
  .table-ability, .table-equipment { display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem; }
  .table-ability img { border: 1px solid #444; border-radius: 7px; }
  .replay-gap { margin-top: 1rem; padding: 0.75rem 0.85rem; border-left: 3px solid #666; background: #121212; }
  @media (max-width: 900px) { .toc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tip-list { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .guide-panel { margin-bottom: 2rem; padding: 1rem; } .toc-grid { grid-template-columns: 1fr; } .overview-card { grid-template-columns: 1fr; padding: 0.9rem; } .stage-card { grid-template-columns: 1fr; } .boss-card { grid-template-columns: 1fr; } summary { align-items: flex-start; } }
</style>
