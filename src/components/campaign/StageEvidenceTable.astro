---
import CharacterRank from "./CharacterRank.astro";
import type {
  CampaignMode,
  CampaignVideo,
  CharacterReference,
  RankReference,
} from "../../lib/campaigns";

interface Props {
  modes: CampaignMode[];
  videos: Record<string, CampaignVideo>;
  characters: Record<string, CharacterReference>;
  ranks: Record<string, RankReference>;
}

const { modes, videos, characters, ranks } = Astro.props;
const allEvidence = modes.flatMap((mode) =>
  mode.stages.flatMap((stage) => stage.evidence.map((evidence) => ({ mode, stage, evidence }))),
);
const creators = [...new Set(allEvidence.map(({ evidence }) => videos[evidence.videoId].creator))].sort((a, b) =>
  a.localeCompare(b),
);
const requiredCharacterIds = ["ultraTigurius", "ultraEliminatorSgt", "ultraInceptorSgt"];
const requiredCharacterIdSet = new Set(requiredCharacterIds);
const requiredCharacters = requiredCharacterIds.map((characterId) => characters[characterId]);
const supportingCharacterIds = [
  ...new Set(
    allEvidence.flatMap(({ evidence }) =>
      evidence.roster
        .filter(({ characterId }) => !requiredCharacterIdSet.has(characterId))
        .map(({ characterId }) => characterId),
    ),
  ),
].sort((left, right) => characters[left].shortName.localeCompare(characters[right].shortName));
const rankOptions = Object.values(ranks).sort((left, right) => left.sort - right.sort);
const getTimestampedVideoUrl = (url: string, timestampSeconds?: number) => {
  if (timestampSeconds == null) return url;
  const timestampedUrl = new URL(url);
  timestampedUrl.searchParams.set("t", `${timestampSeconds}s`);
  return timestampedUrl.toString();
};
---

<section class="filter-section" aria-labelledby="campaign-filter-heading">
  <h2 id="campaign-filter-heading">Campaign Guide Filters</h2>
  <form class="filters" data-campaign-filters>
    {requiredCharacters.map((character) => (
      <div class="filter-field menu-field" data-menu-field>
        <span class="filter-label" title={`${character.shortName} maximum rank`}>
          <img class="filter-label-icon" src={character.portrait} alt="" width="28" height="28" loading="lazy" />
          <span class="visually-hidden">{character.shortName}</span>
          <span>Max rank</span>
        </span>
        <button
          class="filter-toggle"
          type="button"
          aria-label={`${character.shortName} maximum rank`}
          aria-expanded="false"
          data-menu-toggle
          data-rank-toggle={character.id}
          data-max-sort=""
        >
          <span class="toggle-content">
            <img class="toggle-icon" data-toggle-icon src="" alt="" width="26" height="26" hidden />
            <span data-toggle-text>Any rank</span>
          </span>
          <span class="chevron" aria-hidden="true">▾</span>
        </button>
        <div class="filter-menu rank-menu" data-filter-menu hidden>
          <button
            class="filter-option"
            type="button"
            data-rank-option
            data-rank-id=""
            data-rank-sort=""
            data-rank-label="Any rank"
            data-rank-badge=""
          >
            <span class="empty-option-icon" aria-hidden="true">—</span>
            <span>Any rank</span>
          </button>
          {rankOptions.map((rank) => (
            <button
              class="filter-option"
              type="button"
              data-rank-option
              data-rank-id={rank.id}
              data-rank-sort={rank.sort}
              data-rank-label={rank.name}
              data-rank-badge={rank.badge}
            >
              <img src={rank.badge} alt="" width="28" height="28" loading="lazy" />
              <span>{rank.name}</span>
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="filter-field menu-field" data-menu-field>
      <span class="filter-label">Supporting Heroes</span>
      <button class="filter-toggle" type="button" aria-expanded="false" data-menu-toggle data-hero-toggle="supporting">
        <span class="toggle-content">
          <img class="toggle-icon" data-toggle-icon src="" alt="" width="26" height="26" hidden />
          <span data-toggle-text>Select all that apply</span>
        </span>
        <span class="chevron" aria-hidden="true">▾</span>
      </button>
      <div class="filter-menu hero-menu" data-filter-menu hidden>
        {supportingCharacterIds.map((characterId) => {
          const character = characters[characterId];
          return (
            <label class="hero-option">
              <input
                type="checkbox"
                name="supportingHero"
                value={characterId}
                data-hero-checkbox="supporting"
                data-icon={character.portrait}
              />
              <img src={character.portrait} alt="" width="32" height="32" loading="lazy" />
              <span>{character.shortName}</span>
            </label>
          );
        })}
      </div>
    </div>

    <details class="more-filters" data-more-filters>
      <summary>
        <span>More Filters</span>
        <span class="active-filter-count" data-more-filter-count hidden></span>
      </summary>
      <div class="more-filter-panel">
        <div class="filter-field menu-field" data-menu-field>
          <span class="filter-label">Excluded Heroes</span>
          <button class="filter-toggle" type="button" aria-expanded="false" data-menu-toggle data-hero-toggle="excluded">
            <span class="toggle-content">
              <img class="toggle-icon" data-toggle-icon src="" alt="" width="26" height="26" hidden />
              <span data-toggle-text>Select all that apply</span>
            </span>
            <span class="chevron" aria-hidden="true">▾</span>
          </button>
          <div class="filter-menu hero-menu" data-filter-menu hidden>
            {supportingCharacterIds.map((characterId) => {
              const character = characters[characterId];
              return (
                <label class="hero-option">
                  <input
                    type="checkbox"
                    name="excludedHero"
                    value={characterId}
                    data-hero-checkbox="excluded"
                    data-icon={character.portrait}
                  />
                  <img src={character.portrait} alt="" width="32" height="32" loading="lazy" />
                  <span>{character.shortName}</span>
                </label>
              );
            })}
          </div>
        </div>

        <div class="filter-field menu-field" data-menu-field>
          <span class="filter-label">Stage</span>
          <button class="filter-toggle" type="button" aria-expanded="false" data-menu-toggle data-multi-toggle="stage">
            <span class="toggle-content">
              <span data-toggle-text>All stages</span>
            </span>
            <span class="chevron" aria-hidden="true">▾</span>
          </button>
          <div class="filter-menu multi-menu" data-filter-menu hidden>
            {modes.flatMap((mode) =>
              mode.stages.map((stage) => (
                <label class="multi-option stage-option">
                  <input type="checkbox" name="stage" value={`${mode.id}:${stage.number}`} data-multi-checkbox="stage" />
                  <span>{mode.name} {stage.number}</span>
                </label>
              )),
            )}
          </div>
        </div>

        <div class="filter-field menu-field creator-filter" data-menu-field>
          <span class="filter-label">
            <img class="filter-label-icon youtube-icon" src="/images/replay-library/YTLogo.webp" alt="" width="28" height="28" loading="lazy" />
            <span>Creator</span>
          </span>
          <button class="filter-toggle" type="button" aria-expanded="false" data-menu-toggle data-multi-toggle="creator">
            <span class="toggle-content">
              <img class="toggle-icon youtube-icon" src="/images/replay-library/YTLogo.webp" alt="" width="26" height="26" />
              <span data-toggle-text>All creators</span>
            </span>
            <span class="chevron" aria-hidden="true">▾</span>
          </button>
          <div class="filter-menu multi-menu" data-filter-menu hidden>
            {creators.map((creator) => (
              <label class="multi-option creator-option">
                <input type="checkbox" name="creator" value={creator} data-multi-checkbox="creator" />
                <img class="youtube-icon" src="/images/replay-library/YTLogo.webp" alt="" width="32" height="32" loading="lazy" />
                <span>{creator}</span>
              </label>
            ))}
          </div>
        </div>
      </div>
    </details>

    <button class="clear-filters" type="reset">Clear filters</button>
  </form>
</section>

<section class="mode-filter-section" aria-labelledby="campaign-mode-filter-heading">
  <h2 id="campaign-mode-filter-heading">Mode</h2>
  <div class="mode-filter-buttons" aria-label="Campaign modes">
    {modes.map((mode) => (
      <button
        class="mode-filter-button"
        type="button"
        aria-pressed={mode.id === "normal" ? "true" : "false"}
        data-mode-filter={mode.id}
      >
        {mode.name}
      </button>
    ))}
  </div>
</section>

<section class="strategies-section" aria-labelledby="campaign-strategies-heading" data-campaign-evidence>
  <h2 id="campaign-strategies-heading">Campaign Strategies</h2>

  <div class="stage-table" role="region" aria-label="Indomitus stage replay evidence" tabindex="0">
    <div class="table-header" aria-hidden="true">
      <span class="expand-header">+</span>
      <span>Mode</span>
      <span>Stage</span>
      <span>Replay count</span>
      <span>Supporting characters</span>
    </div>

    {modes.flatMap((mode) =>
      mode.stages.map((stage) => {
        const stageSupportingCharacterIds = [
          ...new Set(
            stage.evidence.flatMap((evidence) =>
              evidence.roster
                .filter(({ characterId }) => !requiredCharacterIdSet.has(characterId))
                .map(({ characterId }) => characterId),
            ),
          ),
        ];
        return (
          <details class="stage-row" data-stage-row data-mode={mode.id} data-stage={`${mode.id}:${stage.number}`}>
            <summary>
              <span class="expand-indicator" aria-hidden="true">+</span>
              <span class={`mode-label mode-${mode.id}`}>{mode.name}</span>
              <strong class="stage-number">{stage.number}</strong>
              <span class="replay-count"><span data-visible-count>{stage.evidence.length}</span> <span data-replay-word>{stage.evidence.length === 1 ? "replay" : "replays"}</span></span>
              <span class="supporting-characters">
                {stageSupportingCharacterIds.map((characterId) => (
                  <img
                    src={characters[characterId].portrait}
                    alt={characters[characterId].name}
                    title={characters[characterId].shortName}
                    width="46"
                    height="46"
                    loading="lazy"
                    data-supporting-summary-character={characterId}
                    data-supporting-summary-name={characters[characterId].shortName}
                  />
                ))}
                <span
                  class="supporting-empty"
                  aria-label="No supporting characters"
                  data-supporting-summary-empty
                  hidden={stageSupportingCharacterIds.length > 0}
                >—</span>
              </span>
            </summary>

            <div class="evidence-list">
              {stage.evidence.map((evidence) => {
                const video = videos[evidence.videoId];
                const videoUrl = getTimestampedVideoUrl(video.url, evidence.timestampSeconds);
                const highestRankSort = Math.max(...evidence.roster.map(({ rankId }) => ranks[rankId].sort));
                const rosterData = evidence.roster.map(({ characterId, rankId }) => `${characterId}:${rankId}`).join("|");
                const requiredRankData = evidence.roster
                  .filter(({ characterId }) => requiredCharacterIdSet.has(characterId))
                  .map(({ characterId, rankId }) => `${characterId}:${ranks[rankId].sort}`)
                  .join("|");
                const supportingCharacterData = evidence.roster
                  .filter(({ characterId }) => !requiredCharacterIdSet.has(characterId))
                  .map(({ characterId }) => characterId)
                  .join("|");
                return (
                  <article
                    class="evidence-card"
                    data-evidence-card
                    data-creator={video.creator}
                    data-roster={rosterData}
                    data-required-ranks={requiredRankData}
                    data-supporting-characters={supportingCharacterData}
                  >
                    <div class="roster">
                      {evidence.roster.map(({ characterId, rankId }) => (
                        <CharacterRank
                          character={characters[characterId]}
                          rank={ranks[rankId]}
                          highlighted={ranks[rankId].sort === highestRankSort}
                        />
                      ))}
                    </div>
                    <a
                      class="video-link"
                      href={videoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${video.creator} replay${evidence.timestamp ? ` at ${evidence.timestamp}` : ""} on YouTube`}
                    >
                      <span class="play-icon" aria-hidden="true">&#9654;</span>
                      <span>
                        <strong>{video.creator}</strong>
                        <small>{video.title}{evidence.timestamp ? ` · Starts at ${evidence.timestamp}` : ""}</small>
                      </span>
                    </a>
                  </article>
                );
              })}
            </div>
          </details>
        );
      }),
    )}
  </div>

  <p class="empty-state" data-empty-state hidden>No replay observations match these filters.</p>
</section>

<script>
  const filterForm = document.querySelector("[data-campaign-filters]");
  const stageRows = Array.from(document.querySelectorAll("[data-stage-row]"));
  const emptyState = document.querySelector("[data-empty-state]");
  const menuToggles = Array.from(document.querySelectorAll("[data-menu-toggle]"));
  const rankToggles = Array.from(document.querySelectorAll("[data-rank-toggle]"));
  const heroToggles = Array.from(document.querySelectorAll("[data-hero-toggle]"));
  const multiToggles = Array.from(document.querySelectorAll("[data-multi-toggle]"));
  const modeFilterButtons = Array.from(document.querySelectorAll("[data-mode-filter]"));
  const statisticsSection = document.querySelector("[data-campaign-statistics]");
  const statisticsGrid = document.querySelector("[data-statistics-grid]");
  const statisticsEmpty = document.querySelector("[data-statistics-empty]");
  type StatisticRank = { name: string; sort: number; badge: string };
  let statisticRankMap: Record<string, StatisticRank> = {};
  if (statisticsSection instanceof HTMLElement) {
    try {
      statisticRankMap = JSON.parse(statisticsSection.dataset.rankMap || "{}");
    } catch {
      statisticRankMap = {};
    }
  }

  const closeMenu = (toggle: Element) => {
    if (!(toggle instanceof HTMLButtonElement)) return;
    const menu = toggle.closest("[data-menu-field]")?.querySelector("[data-filter-menu]");
    if (menu instanceof HTMLElement) menu.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
  };

  const closeAllMenus = (exceptToggle: Element | null = null) => {
    menuToggles.forEach((toggle) => {
      if (toggle !== exceptToggle) closeMenu(toggle);
    });
  };

  const updateHeroToggle = (filterName: string) => {
    const toggle = heroToggles.find((candidate) => candidate.getAttribute("data-hero-toggle") === filterName);
    if (!(toggle instanceof HTMLButtonElement) || !(filterForm instanceof HTMLFormElement)) return;
    const selected = Array.from(
      filterForm.querySelectorAll(`[data-hero-checkbox="${filterName}"]:checked`),
    );
    const text = toggle.querySelector("[data-toggle-text]");
    const icon = toggle.querySelector("[data-toggle-icon]");

    if (text) text.textContent = selected.length ? `${selected.length} selected` : "Select all that apply";
    if (icon instanceof HTMLImageElement) {
      const firstSelected = selected[0];
      const iconPath = firstSelected instanceof HTMLInputElement ? firstSelected.dataset.icon || "" : "";
      icon.src = iconPath;
      icon.hidden = !iconPath;
    }
  };

  const getSelectedMultiValues = (filterName: string) => {
    if (!(filterForm instanceof HTMLFormElement)) return [];
    return Array.from(filterForm.querySelectorAll(`[data-multi-checkbox="${filterName}"]:checked`)).flatMap(
      (checkbox) => checkbox instanceof HTMLInputElement ? [checkbox.value] : [],
    );
  };

  const updateMultiToggle = (filterName: string) => {
    const toggle = multiToggles.find((candidate) => candidate.getAttribute("data-multi-toggle") === filterName);
    if (!(toggle instanceof HTMLButtonElement)) return;
    const selectedCount = getSelectedMultiValues(filterName).length;
    const text = toggle.querySelector("[data-toggle-text]");
    if (!text) return;

    if (!selectedCount) {
      text.textContent = {
        mode: "All modes",
        stage: "All stages",
        creator: "All creators",
      }[filterName] || "All";
      return;
    }

    const noun = filterName === "mode" ? "mode" : filterName === "stage" ? "stage" : "creator";
    text.textContent = `${selectedCount} ${noun}${selectedCount === 1 ? "" : "s"} selected`;
  };

  const updateMoreFilterCount = () => {
    if (!(filterForm instanceof HTMLFormElement)) return;
    const excludedHeroCount = filterForm.querySelectorAll('[data-hero-checkbox="excluded"]:checked').length;
    const count =
      excludedHeroCount +
      getSelectedMultiValues("stage").length +
      getSelectedMultiValues("creator").length;
    const badge = filterForm.querySelector("[data-more-filter-count]");
    if (badge instanceof HTMLElement) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
  };

  const updateStatistics = () => {
    if (!(statisticsGrid instanceof HTMLElement)) return;
    const observations = new Map<
      string,
      { eliteStages: Set<string>; normalStages: Set<string>; highestRankId: string; highestSort: number }
    >();
    document.querySelectorAll("[data-evidence-card]:not([hidden])").forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      const stageRow = card.closest("[data-stage-row]");
      if (!(stageRow instanceof HTMLElement)) return;
      const modeId = stageRow.dataset.mode || "";
      const stageKey = stageRow.dataset.stage || "";
      (card.dataset.roster || "").split("|").filter(Boolean).forEach((entry) => {
        const [characterId, rankId] = entry.split(":");
        const rank = statisticRankMap[rankId];
        if (!characterId || !rank) return;
        const current = observations.get(characterId);
        const eliteStages = new Set(current?.eliteStages || []);
        const normalStages = new Set(current?.normalStages || []);
        if (modeId === "elite") eliteStages.add(stageKey);
        if (modeId === "normal") normalStages.add(stageKey);
        observations.set(characterId, {
          eliteStages,
          normalStages,
          highestRankId: !current || rank.sort > current.highestSort ? rankId : current.highestRankId,
          highestSort: !current || rank.sort > current.highestSort ? rank.sort : current.highestSort,
        });
      });
    });

    const statCards = Array.from(statisticsGrid.querySelectorAll("[data-character-stat]")).filter(
      (card): card is HTMLElement => card instanceof HTMLElement,
    );
    statCards.forEach((card) => {
      const characterId = card.dataset.characterId || "";
      const statistic = observations.get(characterId);
      card.hidden = !statistic;
      const stageCount = (statistic?.eliteStages.size || 0) + (statistic?.normalStages.size || 0);
      card.dataset.currentStageCount = String(stageCount);
      const supportingCheckbox = filterForm?.querySelector(
        `[data-hero-checkbox="supporting"][value="${characterId}"]`,
      );
      if (card.dataset.statGroup === "supporting") {
        const isSelected = supportingCheckbox instanceof HTMLInputElement && supportingCheckbox.checked;
        card.setAttribute(
          "aria-pressed",
          String(isSelected),
        );
        card.setAttribute(
          "aria-label",
          `${isSelected ? "Remove" : "Require"} ${card.dataset.characterName || "hero"} in Supporting Heroes`,
        );
      }
      if (!statistic) return;

      const eliteCount = statistic.eliteStages.size;
      const normalCount = statistic.normalStages.size;
      const eliteStageCount = card.querySelector("[data-elite-stage-count]");
      const normalStageCount = card.querySelector("[data-normal-stage-count]");
      if (eliteStageCount) {
        eliteStageCount.textContent = `Elite: ${eliteCount} ${eliteCount === 1 ? "stage" : "stages"}`;
      }
      if (normalStageCount) {
        normalStageCount.textContent = `Normal: ${normalCount} ${normalCount === 1 ? "stage" : "stages"}`;
      }
      const rank = statisticRankMap[statistic.highestRankId];
      const rankBadge = card.querySelector(".rank-badge");
      const rankImage = rankBadge?.querySelector("img");
      const rankCaption = rankBadge?.querySelector("figcaption");
      if (rankBadge && rank) rankBadge.setAttribute("title", rank.name);
      if (rankImage instanceof HTMLImageElement && rank) {
        rankImage.src = rank.badge;
        rankImage.alt = `${rank.name} rank badge`;
      }
      if (rankCaption && rank) rankCaption.textContent = rank.name;
    });

    const requiredCards = statCards.filter((card) => card.dataset.statGroup === "required");
    const supportingCards = statCards
      .filter((card) => card.dataset.statGroup === "supporting")
      .sort((left, right) => {
        const stageDifference =
          Number(right.dataset.currentStageCount || 0) - Number(left.dataset.currentStageCount || 0);
        return stageDifference || (left.dataset.characterName || "").localeCompare(right.dataset.characterName || "");
      });
    [...requiredCards, ...supportingCards].forEach((card) => statisticsGrid.append(card));

    if (statisticsEmpty instanceof HTMLElement) {
      statisticsEmpty.hidden = statCards.some((card) => !card.hidden);
    }
  };

  const applyFilters = () => {
    if (!(filterForm instanceof HTMLFormElement)) return;
    const selectedModes = modeFilterButtons.flatMap((button) =>
      button instanceof HTMLButtonElement && button.getAttribute("aria-pressed") === "true"
        ? [button.dataset.modeFilter || ""]
        : [],
    );
    const selectedStages = getSelectedMultiValues("stage");
    const selectedCreators = getSelectedMultiValues("creator");
    const supportingHeroes = Array.from(filterForm.querySelectorAll('[data-hero-checkbox="supporting"]:checked'))
      .filter((checkbox) => checkbox instanceof HTMLInputElement)
      .map((checkbox) => checkbox.value);
    const excludedHeroes = Array.from(filterForm.querySelectorAll('[data-hero-checkbox="excluded"]:checked'))
      .filter((checkbox) => checkbox instanceof HTMLInputElement)
      .map((checkbox) => checkbox.value);
    let visibleStageCount = 0;

    stageRows.forEach((stageRow) => {
      if (!(stageRow instanceof HTMLElement)) return;
      const modeMatches = selectedModes.includes(stageRow.dataset.mode || "");
      const stageMatches = !selectedStages.length || selectedStages.includes(stageRow.dataset.stage || "");
      const evidenceCards = Array.from(stageRow.querySelectorAll("[data-evidence-card]"));
      const visibleSupportingCharacterCounts = new Map<string, number>();
      let visibleEvidenceCount = 0;

      evidenceCards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const creatorMatches = !selectedCreators.length || selectedCreators.includes(card.dataset.creator || "");
        const requiredRanks = Object.fromEntries(
          (card.dataset.requiredRanks || "")
            .split("|")
            .filter(Boolean)
            .map((entry) => entry.split(":")),
        );
        const maxRanksMatch = rankToggles.every((toggle) => {
          if (!(toggle instanceof HTMLButtonElement) || !toggle.dataset.maxSort) return true;
          const characterId = toggle.dataset.rankToggle || "";
          return Number(requiredRanks[characterId]) <= Number(toggle.dataset.maxSort);
        });
        const supportingCharacters = (card.dataset.supportingCharacters || "").split("|").filter(Boolean);
        const supportingMatch =
          !supportingHeroes.length || supportingHeroes.some((characterId) => supportingCharacters.includes(characterId));
        const excludedMatch = excludedHeroes.every((characterId) => !supportingCharacters.includes(characterId));
        const matches = modeMatches && stageMatches && creatorMatches && maxRanksMatch && supportingMatch && excludedMatch;
        card.hidden = !matches;
        if (matches) {
          visibleEvidenceCount += 1;
          supportingCharacters.forEach((characterId) => {
            visibleSupportingCharacterCounts.set(
              characterId,
              (visibleSupportingCharacterCounts.get(characterId) || 0) + 1,
            );
          });
        }
      });

      stageRow.hidden = visibleEvidenceCount === 0;
      const count = stageRow.querySelector("[data-visible-count]");
      if (count) count.textContent = String(visibleEvidenceCount);
      const replayWord = stageRow.querySelector("[data-replay-word]");
      if (replayWord) replayWord.textContent = visibleEvidenceCount === 1 ? "replay" : "replays";
      const supportingContainer = stageRow.querySelector(".supporting-characters");
      const supportingPortraits = Array.from(
        stageRow.querySelectorAll("[data-supporting-summary-character]"),
      ).filter((portrait): portrait is HTMLImageElement => portrait instanceof HTMLImageElement);
      supportingPortraits
        .sort((left, right) => {
          const countDifference =
            (visibleSupportingCharacterCounts.get(right.dataset.supportingSummaryCharacter || "") || 0) -
            (visibleSupportingCharacterCounts.get(left.dataset.supportingSummaryCharacter || "") || 0);
          return countDifference ||
            (left.dataset.supportingSummaryName || "").localeCompare(right.dataset.supportingSummaryName || "");
        })
        .forEach((portrait) => {
          portrait.hidden = !visibleSupportingCharacterCounts.has(portrait.dataset.supportingSummaryCharacter || "");
          supportingContainer?.append(portrait);
        });
      const supportingEmpty = stageRow.querySelector("[data-supporting-summary-empty]");
      if (supportingEmpty instanceof HTMLElement) {
        supportingEmpty.hidden = visibleSupportingCharacterCounts.size > 0;
        supportingContainer?.append(supportingEmpty);
      }
      if (visibleEvidenceCount > 0) visibleStageCount += 1;
    });

    if (emptyState instanceof HTMLElement) emptyState.hidden = visibleStageCount > 0;
    updateMoreFilterCount();
    updateStatistics();
  };

  menuToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      if (!(toggle instanceof HTMLButtonElement)) return;
      const menu = toggle.closest("[data-menu-field]")?.querySelector("[data-filter-menu]");
      if (!(menu instanceof HTMLElement)) return;
      const willOpen = menu.hidden;
      closeAllMenus(toggle);
      menu.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", String(willOpen));
    });
  });

  modeFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const isSelected = button.getAttribute("aria-pressed") === "true";
      button.setAttribute("aria-pressed", String(!isSelected));
      applyFilters();
    });
  });

  filterForm?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const option = event.target.closest("[data-rank-option]");
    if (!(option instanceof HTMLButtonElement)) return;
    const field = option.closest("[data-menu-field]");
    const toggle = field?.querySelector("[data-rank-toggle]");
    if (!(toggle instanceof HTMLButtonElement)) return;

    toggle.dataset.maxSort = option.dataset.rankSort || "";
    const text = toggle.querySelector("[data-toggle-text]");
    const icon = toggle.querySelector("[data-toggle-icon]");
    if (text) text.textContent = option.dataset.rankLabel || "Any rank";
    if (icon instanceof HTMLImageElement) {
      icon.src = option.dataset.rankBadge || "";
      icon.hidden = !option.dataset.rankBadge;
    }
    field?.querySelectorAll("[data-rank-option]").forEach((candidate) => {
      candidate.setAttribute("aria-selected", String(candidate === option));
    });
    closeMenu(toggle);
    applyFilters();
  });

  filterForm?.addEventListener("change", (event) => {
    if (!(event.target instanceof HTMLInputElement)) return;
    const changedCheckbox = event.target;

    if (changedCheckbox.matches("[data-hero-checkbox]")) {
      const filterName = changedCheckbox.dataset.heroCheckbox || "";
      if (changedCheckbox.checked) {
        const oppositeName = filterName === "supporting" ? "excluded" : "supporting";
        const opposite = Array.from(filterForm.querySelectorAll(`[data-hero-checkbox="${oppositeName}"]`)).find(
          (candidate) => candidate instanceof HTMLInputElement && candidate.value === changedCheckbox.value,
        );
        if (opposite instanceof HTMLInputElement) opposite.checked = false;
        updateHeroToggle(oppositeName);
      }
      updateHeroToggle(filterName);
    }

    if (changedCheckbox.matches("[data-multi-checkbox]")) {
      updateMultiToggle(changedCheckbox.dataset.multiCheckbox || "");
    }

    applyFilters();
  });

  const enableSupportingHeroFromStatistic = (trigger: Element) => {
    if (!(filterForm instanceof HTMLFormElement)) return;
    const characterId = trigger.getAttribute("data-supporting-stat-trigger") || "";
    const supportingCheckbox = Array.from(
      filterForm.querySelectorAll('[data-hero-checkbox="supporting"]'),
    ).find((candidate) => candidate instanceof HTMLInputElement && candidate.value === characterId);
    if (!(supportingCheckbox instanceof HTMLInputElement)) return;
    supportingCheckbox.checked = !supportingCheckbox.checked;

    const excludedCheckbox = Array.from(
      filterForm.querySelectorAll('[data-hero-checkbox="excluded"]'),
    ).find((candidate) => candidate instanceof HTMLInputElement && candidate.value === characterId);
    if (supportingCheckbox.checked && excludedCheckbox instanceof HTMLInputElement) excludedCheckbox.checked = false;
    updateHeroToggle("supporting");
    updateHeroToggle("excluded");
    applyFilters();
  };

  statisticsGrid?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest("[data-supporting-stat-trigger]");
    if (trigger) enableSupportingHeroFromStatistic(trigger);
  });

  statisticsGrid?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent) || !(event.target instanceof Element) || !["Enter", " "].includes(event.key)) return;
    const trigger = event.target.closest("[data-supporting-stat-trigger]");
    if (!trigger) return;
    event.preventDefault();
    enableSupportingHeroFromStatistic(trigger);
  });

  filterForm?.addEventListener("reset", () => {
    window.setTimeout(() => {
      rankToggles.forEach((toggle) => {
        if (!(toggle instanceof HTMLButtonElement)) return;
        toggle.dataset.maxSort = "";
        const text = toggle.querySelector("[data-toggle-text]");
        const icon = toggle.querySelector("[data-toggle-icon]");
        if (text) text.textContent = "Any rank";
        if (icon instanceof HTMLImageElement) {
          icon.src = "";
          icon.hidden = true;
        }
      });
      updateHeroToggle("supporting");
      updateHeroToggle("excluded");
      updateMultiToggle("stage");
      updateMultiToggle("creator");
      modeFilterButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.getAttribute("data-mode-filter") === "normal"));
      });
      stageRows.forEach((stageRow) => {
        if (stageRow instanceof HTMLDetailsElement) stageRow.open = false;
      });
      closeAllMenus();
      applyFilters();
    });
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("[data-menu-field]")) return;
    closeAllMenus();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllMenus();
  });

  applyFilters();
</script>

