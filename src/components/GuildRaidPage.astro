---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import CuratedReplayTable from "./replay-library/CuratedReplayTable.astro";
import { graphics } from "../data/graphics";
import replayCsv from "../data/GR-replays-v2.csv?raw";
import replayRows from "../data/replay-library/PgC5E7jYNBPh8SoE9CGtXMH.json";
import bossRows from "../data/replay-library/bosses.json";
import characterRows from "../data/replay-library/characters.json";
import mapRows from "../data/replay-library/maps_directory.json";
import teamTemplateRows from "../data/replay-library/team_templates.json";
import teamArchetypeRows from "../data/replay-library/team_archetype.json";
import {
  createReplayLibraryData,
  extractYouTubeVideoId,
  formatReplayDamage,
  formatReplayPublishedAt,
  parseReplayDamage,
  parseReplayPublishedAt
} from "../lib/replayLibrary";

const {
  title,
  description,
  sectionTitle,
  seasonNumber,
  guides = []
} = Astro.props;

const archiveGuide = {
  title: "Guild Raid Archive",
  href: "/guild-raid/archive",
  description: "Browse previous Guild Raid seasons, boss lineups, maps, and infographic archives.",
  thumbnail: "/images/web/guild-raid-s101-mythic.webp"
};

const relatedGuides = [
  archiveGuide,
  ...graphics.filter(
    (g) =>
      g.href !== Astro.url.pathname &&
      g.href !== "/guild-raid/archive"
  )
];

const sortedRelatedGuides = relatedGuides.sort((a, b) => {
  const priority = {
    "/guild-raid/boss-meta": 1,
    "/guild-raid/archive": 2
  };

  return (priority[a.href] || 99) - (priority[b.href] || 99);
});

const pageImage = guides[0]?.webImageSrc || guides[0]?.imageSrc;

// Future season pages only need their `seasonNumber` and image paths updated;
// curated Mythic/Legendary replay picks come from GR-replays-v2.csv by video_id.
function parseCsv(csv) {
  const rows = [];
  let row = [];
  let field = "";
  let inQuotes = false;

  for (let i = 0; i < csv.length; i++) {
    const char = csv[i];
    const next = csv[i + 1];

    if (char === '"' && inQuotes && next === '"') {
      field += '"';
      i++;
    } else if (char === '"') {
      inQuotes = !inQuotes;
    } else if (char === "," && !inQuotes) {
      row.push(field);
      field = "";
    } else if ((char === "\n" || char === "\r") && !inQuotes) {
      if (field || row.length) {
        row.push(field);
        rows.push(row);
        row = [];
        field = "";
      }
      if (char === "\r" && next === "\n") i++;
    } else {
      field += char;
    }
  }

  if (field || row.length) rows.push([...row, field]);

  const headers = rows.shift();

  return rows.map((values) =>
    Object.fromEntries(headers.map((header, index) => [header, values[index] || ""]))
  );
}

const tierOrder = {
  M2: 1, M1: 2,
  L5: 3, L4: 4, L3: 5, L2: 6, L1: 7,
  E5: 8, E4: 9, E3: 10, E2: 11, E1: 12
};

const replayLibraryData = createReplayLibraryData(
  replayRows,
  bossRows,
  characterRows,
  mapRows,
  teamTemplateRows
);

const teamIconMap = Object.fromEntries(
  teamArchetypeRows.map((team) => [team.team_archetype, team.team_icon])
);

const replayByVideoId = Object.fromEntries(
  replayLibraryData.replays.map((replay) => [replay.videoId, replay])
);

const rawReplayByVideoId = Object.fromEntries(
  replayRows.map((replay) => [replay.video_id || extractYouTubeVideoId(replay.video_url || ""), replay])
);

function createMinimalReplay(row) {
  const videoId = row.video_id?.trim();
  const replay = rawReplayByVideoId[videoId];

  if (!replay) return null;

  const damage = parseReplayDamage(replay.damage_final, replay.damage_guess);
  const publishedAt = replay.published_at || "";

  return {
    id: `${replay.video_url || videoId}-guild-raid-fallback`,
    videoId,
    boss: replay.boss_final || replay.boss_guess || "Replay",
    bossLongName: replay.boss_final || replay.boss_guess || "Replay",
    team: replay.team_archetype || "",
    map: replay.map || "",
    tier: row.TIER || row.Tier || replay.tier_final || "",
    damage,
    damageLabel: damage > 0 ? formatReplayDamage(damage) : "-",
    heroes: [replay.hero_1, replay.hero_2, replay.hero_3, replay.hero_4, replay.hero_5].filter(Boolean),
    mow: replay.MoW || "",
    creator: replay.creator || "Unknown",
    videoUrl: replay.video_url || `https://www.youtube.com/watch?v=${videoId}`,
    publishedAt,
    publishedAtLabel: formatReplayPublishedAt(publishedAt),
    publishedAtTimestamp: parseReplayPublishedAt(publishedAt)
  };
}

const seasonReplayRefs = parseCsv(replayCsv)
  .filter((row) => String(row.SEASON || row.Season) === String(seasonNumber))
  .sort((a, b) => {
    const tierDiff = (tierOrder[a.TIER || a.Tier] || 99) - (tierOrder[b.TIER || b.Tier] || 99);
    return tierDiff;
  });

const seasonReplays = seasonReplayRefs
  .map((row) => {
    const videoId = row.video_id?.trim();
    const tier = row.TIER || row.Tier;
    const replay = replayByVideoId[videoId] || createMinimalReplay(row);

    if (!replay) {
      console.warn(`Guild Raid Season ${seasonNumber}: replay video_id "${videoId}" was not found in Replay Library JSON.`);
      return null;
    }

    return {
      ...replay,
      tier: tier || replay.tier
    };
  })
  .filter((replay) => Boolean(replay));

const mythicReplays = seasonReplays.filter((replay) => replay.tier.startsWith("M"));
const legendaryReplays = seasonReplays.filter((replay) => replay.tier.startsWith("L"));
const guideReplaySections = guides.map((guide) => {
  const isMythic = guide.title.includes("Mythic");
  const isLegendary = guide.title.includes("Legendary");
  const replays = isMythic ? mythicReplays : isLegendary ? legendaryReplays : [];

  return {
    guide,
    replays,
    replayHeading: isMythic ? "Mythic Replays" : isLegendary ? "Legendary Replays" : "",
    replayDescription: isMythic
      ? "Recommended Mythic runs for this season, pulled from the analyzed Replay Library dataset."
      : isLegendary
        ? "Recommended Legendary runs for this season, pulled from the analyzed Replay Library dataset."
        : ""
    };
});

---

<Layout
  title={`${title} | Terminus Maximus Infographics`}
  description={description}
  image={pageImage}
>
  <Header />

  <main>
  <section class="infographic-section">
    <h2>{sectionTitle}</h2>

    <div class="guide-grid">
      {guideReplaySections.map(({ guide, replays, replayHeading, replayDescription }) => (
        <article class="guide-card">
          <h3>{guide.title}</h3>

            <a
              href={guide.imageSrc}
              target="_blank"
              rel="noopener noreferrer"
              class="image-link"
              data-ga4-infographic-open
              data-ga4-infographic-title={`${title} - ${guide.title}`}
              data-ga4-link-source="image"
            >
            <img
                src={guide.webImageSrc || guide.imageSrc}
                alt={guide.imageAlt}
                class="infographic"
                loading="lazy"
            />
            </a>

          <p class="caption">
            <a
              href={guide.imageSrc}
              target="_blank"
              rel="noopener noreferrer"
              class="caption-link"
              data-ga4-infographic-open
              data-ga4-infographic-title={`${title} - ${guide.title}`}
              data-ga4-link-source="caption"
            >
            CLICK FULL-SIZE INFOGRAPHIC
            </a>
          </p>

          {replays.length > 0 && (
            <div class="guide-replay-box">
              <h4 id={`season-${seasonNumber}-${replayHeading.toLowerCase().replaceAll(" ", "-")}`}>{replayHeading}</h4>
              <p>{replayDescription}</p>
              <CuratedReplayTable
                replays={replays}
                teamIconMap={teamIconMap}
                labelledBy={`season-${seasonNumber}-${replayHeading.toLowerCase().replaceAll(" ", "-")}`}
              />
              <p class="replay-library-cta">
                <a class="replay-library-cta-link" href="/replay-library/"><strong>Need a different replay?</strong></a>
                <span> Search 1,000+ analyzed replays in the </span>
                <a class="replay-library-cta-link" href="/replay-library/">Replay Library</a><span>.</span>
              </p>
            </div>
          )}

        </article>
      ))}
    </div>
  </section>

<section class="content-section">
  <h2>Related Guides</h2>

  <div class="card-grid">
    {sortedRelatedGuides.map((graphic) => (
        <a
          class={`card related-guide-card ${
            graphic.href === "/guild-raid/boss-meta" ||
            graphic.href === "/guild-raid/archive"
              ? "forced-related-card"
              : ""
          }`}
          href={graphic.href}
        >
        <div class="card-image-wrap">
          <img
            src={graphic.thumbnail}
            alt={`${graphic.title} preview`}
            class="card-image"
            loading="lazy"
          />
        </div>

        <h3>{graphic.title}</h3>
        <p>{graphic.description}</p>
      </a>
    ))}
  </div>
</section>

<script>
  const cards = Array.from(document.querySelectorAll(".related-guide-card"));

  const forcedCards = cards.filter((card) =>
    card.classList.contains("forced-related-card")
  );

  const randomCards = cards.filter(
    (card) => !card.classList.contains("forced-related-card")
  );

  randomCards
    .sort(() => Math.random() - 0.5)
    .forEach((card, index) => {
      card.style.display = index < 3 ? "block" : "none";
    });

  forcedCards.forEach((card) => {
    card.style.display = "block";
  });
</script>

  </main>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
    color: #cccccc;
  }

  .infographic-section {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .infographic-section h2,
  .guide-card h3 {
    color: #d4af37;
    margin-top: 0;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    min-width: 0;
  }

  .guide-card {
    border-top: 1px solid #333;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    padding-top: 1.5rem;
  }

  .image-link {
    display: block;
  }

  .infographic {
    max-width: 700px;
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
  }

    .caption-link {
    display: block;
    text-align: center;
    color: #d4af37;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    margin-top: 1rem;
    }

    .caption-link:hover {
    text-decoration: underline;
    }

  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    .infographic-section {
      padding: 1.25rem;
    }
  }

  .content-section {
  background: #1e1e1e;
  border: 1px solid #333;
  border-radius: 12px;
  padding: 1.5rem;
  margin-top: 4rem;
}

.content-section h2 {
  color: #d4af37;
  margin-top: 0;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid #333;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
  gap: 1.5rem;
  justify-content: start;
}

.card {
  background: #121212;
  border: 1px solid #333;
  border-radius: 12px;
  padding: 1.5rem;
  text-decoration: none;
  color: inherit;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.card:hover,
.card:focus-visible {
  border-color: #d4af37;
  transform: translateY(-3px);
  outline: none;
}

.card-image-wrap {
  width: 100%;
  height: 120px;
  overflow: hidden;
  border-radius: 8px;
  margin-bottom: 1rem;
  background: #121212;
  border: 1px solid #333;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: top;
  display: block;
}

.card h3 {
  margin: 0 0 0.5rem;
  color: #d4af37;
  font-size: 1.1rem;
  line-height: 1.3;
}

.card p {
  color: #cccccc;
  line-height: 1.5;
  margin-bottom: 0;
}

.guide-replay-box {
  background: #252525;
  border: 1px solid #333;
  border-radius: 8px;
  box-sizing: border-box;
  margin: 1.5rem auto 0;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  padding: 1rem;
}

.guide-replay-box h4 {
  color: #f5d76e;
  font-size: 1.1rem;
  line-height: 1.35;
  margin: 0 0 0.5rem;
}

.guide-replay-box p {
  color: #cccccc;
  line-height: 1.6;
  margin: 0 0 1rem;
  max-width: 760px;
}

.guide-replay-box .replay-library-cta {
  color: #ffffff;
  line-height: 1.5;
  margin: 1rem auto 0;
  max-width: 100%;
}

.replay-library-cta strong {
  color: #f5d76e;
  font-weight: 700;
}

.replay-library-cta a {
  color: #f5d76e;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 0.18em;
}

.replay-library-cta .replay-library-cta-link {
  text-decoration: none;
}

.replay-library-cta .replay-library-cta-link:hover,
.replay-library-cta .replay-library-cta-link:focus-visible {
  text-decoration: underline;
}

.replay-library-cta a:hover,
.replay-library-cta a:focus-visible {
  color: #d4af37;
}

</style>
