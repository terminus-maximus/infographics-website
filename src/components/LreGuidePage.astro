---
import FeaturedInfographicPage from './FeaturedInfographicPage.astro';
import LrePlanner from './LrePlanner.astro';
import GuideHeroLinks from './heroes/GuideHeroLinks.astro';
import { getLreBasicsContent, type LreCharacter } from '../data/lreBasics';
import type { LrePlannerData } from '../lib/lrePlanner';
import { heroHrefById } from '../lib/heroes.mjs';

interface Props {
  character: LreCharacter;
  heroGuideId?: string;
  imageSrc: string;
  data: LrePlannerData;
  resources?: { title: string; url: string }[];
}

const { character, heroGuideId, imageSrc, data, resources = [] } = Astro.props;
const basics = getLreBasicsContent(character, heroGuideId ? heroHrefById(heroGuideId) : undefined);
const detailsStart = basics.indexOf('## Event Goal');
---

<FeaturedInfographicPage
  title={`${character} Legendary Release Event`}
  description="Event requirements, planning, and best team guide."
  imageSrc={imageSrc}
  imageAlt={`${character} Legendary Release Event Infographic`}
  rosterVersion={data.characterBuild}
  basicsTitle={`${character} LRE Basics`}
  basicsContent={basics.slice(0, detailsStart)}
  basicsDetailsContent={basics.slice(detailsStart)}
  resources={resources}
>
  <Fragment slot="after-basics"><LrePlanner data={data} linkHeroes={Boolean(heroGuideId)} />{!heroGuideId && <GuideHeroLinks />}</Fragment>
</FeaturedInfographicPage>
