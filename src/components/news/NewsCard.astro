---
import { gameUpdate144, type NewsArticle } from '../../data/news';
interface Props { article: NewsArticle; showDate?: boolean }
const { article, showDate = false } = Astro.props;
const description = article.href === gameUpdate144.href
  ? 'Details about the newest heroes & game events'
  : article.description;
---

<a class="news-card" href={article.href} data-ga4-nav-section="news">
  <div class="news-card-image">
    <img src={article.thumbnail} alt={article.thumbnailAlt} width="600" height="337" loading="lazy" />
  </div>
  {showDate && <p class="news-card-date"><time datetime={article.published}>{article.publishedLabel}</time></p>}
  <div class="news-card-title-row"><h3 class="news-card-title">{article.title}</h3></div>
  <p class="news-card-description">{description}</p>
</a>

<style>
  .news-card, .news-card * { box-sizing: border-box; }
  .news-card { display: block; padding: 1.5rem; border: 1px solid #333; border-radius: 12px; background: #1e1e1e; color: inherit; text-decoration: none; transition: border-color .2s ease, transform .2s ease; }
  .news-card:hover, .news-card:focus-visible { border-color: #d4af37; transform: translateY(-3px); outline: none; }
  .news-card-image { width: 100%; height: 120px; overflow: hidden; background: #121212; border: 1px solid #333; border-radius: 8px; margin-bottom: 1rem; }
  .news-card img { width: 100%; height: 100%; object-fit: contain; object-position: top; display: block; }
  .news-card-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  .news-card .news-card-title { margin: 0; color: #d4af37; font-size: 1.1rem; line-height: 1.3; }
  .news-card .news-card-description { color: #fff; line-height: 1.5; margin: 1em 0 0; }
  .news-card .news-card-date { color: #fff; font-size: .8rem; line-height: 1.5; margin: 0 0 .5rem; }
  @media(max-width: 700px) {
    .news-card { padding: 1rem; }
    .news-card-image { height: 110px; }
  }
</style>
