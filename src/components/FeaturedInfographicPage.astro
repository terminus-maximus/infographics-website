---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import RecommendationSections from "./RecommendationSections.astro";
import { marked } from "marked";

const {
  title,
  description,
  imageSrc,
  webImageSrc,
  imageAlt,
  lastUpdated,
  basicsTitle,
  basicsContent,
  basicsDetailsContent,
  noIndex = false,
  resources = []
} = Astro.props;

const basicsHtml = basicsContent ? marked.parse(basicsContent) : "";
const basicsDetailsHtml = basicsDetailsContent ? marked.parse(basicsDetailsContent) : "";

const displayImageSrc =
  webImageSrc ||
  imageSrc.replace(/^\/images\//, "/images/web/").replace(/\.[^.]+$/, ".webp");
---

<Layout
  title={`${title} | Terminus Maximus Infographics`}
  description={description}
  image={displayImageSrc}
>
  <Fragment slot="head">
    {noIndex && <meta name="robots" content="noindex, nofollow, noimageindex" />}
  </Fragment>
  <Header />

  <main>
  <section class="hero">
    <h1>{title}</h1>
    <p>{description}</p>

    {lastUpdated && (
      <p class="last-updated">Last Updated: {lastUpdated}</p>
    )}
  </section>

  <section class="infographic-section">
    <h2>Featured Infographic</h2>

    <a
      href={imageSrc}
      target="_blank"
      rel="noopener noreferrer"
      class="image-link"
      data-ga4-infographic-open
      data-ga4-infographic-title={title}
      data-ga4-link-source="image"
    >
      <img
        src={displayImageSrc}
        alt={imageAlt}
        class="infographic"
        loading="lazy"
      />
    </a>

    <p class="caption">
      <a
        href={imageSrc}
        target="_blank"
        rel="noopener noreferrer"
        class="caption-link"
        data-ga4-infographic-open
        data-ga4-infographic-title={title}
        data-ga4-link-source="caption"
      >
        CLICK FULL-SIZE INFOGRAPHIC
      </a>
    </p>
  </section>

  <slot name="guides" />

  {basicsContent && (
    <section class="content-section">
      <h2>{basicsTitle || `${title} Basics`}</h2>
      <div class="markdown-content" set:html={basicsHtml} />
      {basicsDetailsContent && (
        <details class="event-details">
          <summary>
            <span>More Event Details</span>
            <span class="expand-details">Expand details <span aria-hidden="true">+</span></span>
            <span class="collapse-details">Collapse details <span aria-hidden="true">−</span></span>
          </summary>
          <div class="markdown-content details-content" set:html={basicsDetailsHtml} />
        </details>
      )}
    </section>
  )}

  <slot name="after-basics" />

  {resources.length > 0 && (
    <section class="content-section">
      <h2>Other Resources</h2>

      <ul class="resource-list">
        {resources.map((resource) => (
          <li>
            <a href={resource.url} target="_blank" rel="noopener noreferrer">
              {resource.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <RecommendationSections />
  </main>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
    color: #cccccc;
  }

  .last-updated {
    margin-top: 1rem !important;
    font-size: 0.95rem !important;
    color: #d4af37 !important;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    color: #d4af37;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

  .infographic-section,
  .content-section {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .image-link {
    display: block;
  }

  .infographic {
    max-width: 700px;
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
  }

  .caption {
    margin-bottom: 0;
  }

  .caption-link {
    display: block;
    text-align: center;
    color: #d4af37;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    margin-top: 1rem;
  }

  .caption-link:hover {
    text-decoration: underline;
  }

  .markdown-content {
    color: #cccccc;
    line-height: 1.7;
  }

  .event-details {
    margin-top: 1.5rem;
    border: 1px solid #555;
    border-radius: 8px;
    background: #161616;
  }

  .event-details summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: .6rem 1rem;
    min-height: 44px;
    padding: .8rem 1rem;
    color: #d4af37;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .event-details summary::-webkit-details-marker { display: none; }
  .event-details summary:hover { background: #302b1b; border-radius: 8px; }
  .event-details summary:focus-visible { outline: 2px solid #d4af37; outline-offset: 3px; }
  .expand-details, .collapse-details { font-size: .8rem; }
  .expand-details span, .collapse-details span { margin-left: .4rem; font-size: 1.2rem; }
  .collapse-details, .event-details[open] .expand-details { display: none; }
  .event-details[open] .collapse-details { display: inline; }
  .details-content { padding: 0 1rem 1rem; border-top: 1px solid #333; }

  .markdown-content :global(a),
  .resource-list a {
    color: #d4af37;
  }

  .resource-list {
    margin-bottom: 0;
    color: #cccccc;
    line-height: 1.7;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
    gap: 1.5rem;
    justify-content: start;
  }

  .card {
    background: #121212;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #d4af37;
    transform: translateY(-3px);
    outline: none;
  }

  .card-image-wrap {
    width: 100%;
    height: 120px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: #121212;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    display: block;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card h3 {
    margin: 0;
    color: #d4af37;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card p {
    color: #cccccc;
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .infographic-section,
    .content-section {
      padding: 1rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card {
      padding: 1rem;
    }

    .card-image-wrap {
      height: 110px;
    }
  }
</style>
