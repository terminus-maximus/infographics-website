---
import ReplayIcon from "./ReplayIcon.astro";
import type { ReplayLibraryReplay } from "../../lib/replayLibrary";

interface Props {
  replays: ReplayLibraryReplay[];
  teamIconMap?: Record<string, string>;
  labelledBy?: string;
  sortable?: boolean;
  showTierDividers?: boolean;
}

const {
  replays,
  teamIconMap = {},
  labelledBy,
  sortable = false,
  showTierDividers = true
} = Astro.props;

const getTeamIcon = (team: string) => teamIconMap[team] || team;
const tierSortRank = { M3: 0, M2: 1, M1: 2, L5: 3, L4: 4, L3: 5, L2: 6, L1: 7 };
const displayReplays = sortable ? [...replays].sort((a, b) => b.damage - a.damage) : replays;
---

<div class="table-wrap curated-replay-table-wrap" data-curated-sortable={sortable ? "true" : undefined}>
  <table class="replay-table curated-replay-table" aria-labelledby={labelledBy}>
    <thead>
      <tr>
        <th data-curated-sort-header={sortable ? "boss" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="boss" data-column-index="0">Boss</button> : "Boss"}
        </th>
        <th data-curated-sort-header={sortable ? "team" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="team" data-column-index="1">Team</button> : "Team"}
        </th>
        <th data-curated-sort-header={sortable ? "damage" : undefined} aria-sort={sortable ? "descending" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="damage" data-column-index="2" data-sort-direction="desc">Damage</button> : "Damage"}
        </th>
        <th data-curated-sort-header={sortable ? "tier" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="tier" data-column-index="3">Tier</button> : "Tier"}
        </th>
        <th data-curated-sort-header={sortable ? "map" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="map" data-column-index="4">Map</button> : "Map"}
        </th>
        <th data-curated-sort-header={sortable ? "heroes" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="heroes" data-column-index="5">Heroes</button> : "Heroes"}
        </th>
        <th data-curated-sort-header={sortable ? "mow" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="mow" data-column-index="6">MoW</button> : "MoW"}
        </th>
        <th aria-label="Watch replay"></th>
        <th data-curated-sort-header={sortable ? "creator" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="creator" data-column-index="8">Creator</button> : "Creator"}
        </th>
        <th data-curated-sort-header={sortable ? "publishedAt" : undefined} aria-sort={sortable ? "none" : undefined}>
          {sortable ? <button class="sort-button" type="button" data-curated-sort-key="publishedAt" data-column-index="9">Date</button> : "Date"}
        </th>
      </tr>
    </thead>
    <tbody>
      {displayReplays.map((replay, index) => (
        <tr
          class:list={["replay-row", { "tier-divider-before": showTierDividers && index > 0 && replay.tier !== displayReplays[index - 1].tier }]}
          data-replay-url={replay.videoUrl}
        >
          <td data-label="Boss" data-sort-value={replay.boss}>
            <span class="replay-cell-content">
              <ReplayIcon type="bosses" value={replay.boss} title={replay.boss} className="labeled-icon-wrap" />
            </span>
          </td>
          <td data-label="Team" data-sort-value={replay.team}>
            <span class="replay-cell-content">
              <ReplayIcon type="heroes" value={getTeamIcon(replay.team)} title={replay.team} className="labeled-icon-wrap" />
            </span>
          </td>
          <td data-label="Damage" data-sort-value={replay.damage}>
            <a class="replay-cell-link" href={replay.videoUrl} target="_blank" rel="noopener noreferrer">
              {replay.damageLabel}
            </a>
          </td>
          <td data-label="Tier" data-sort-value={tierSortRank[replay.tier] ?? 99}>
            <a class="replay-cell-link tier-cell" href={replay.videoUrl} target="_blank" rel="noopener noreferrer">
              {replay.tier}
            </a>
          </td>
          <td data-label="Map" data-sort-value={replay.map}>
            <span class="replay-cell-content">
              <ReplayIcon type="maps" value={replay.map} title={replay.map} preview />
            </span>
          </td>
          <td data-label="Heroes" data-sort-value={replay.heroes.join(" ")}>
            <span class="replay-cell-content">
              <div class="hero-icons">
                {replay.heroes.map((hero) => (
                  <ReplayIcon type="heroes" value={hero} title={hero} className="labeled-icon-wrap" />
                ))}
              </div>
            </span>
          </td>
          <td data-label="MoW" data-sort-value={replay.mow}>
            <span class="replay-cell-content">
              <ReplayIcon type="mow" value={replay.mow} title={replay.mow} className="labeled-icon-wrap" />
            </span>
          </td>
          <td data-label="Watch">
            <a
              class="replay-cell-link"
              href={replay.videoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${replay.creator} replay on YouTube`}
            >
              <img
                class="youtube-logo"
                src="/images/replay-library/YTLogo.webp"
                width="28"
                height="20"
                alt="YouTube"
                loading="lazy"
              />
            </a>
          </td>
          <td data-label="Creator" data-sort-value={replay.creator}>
            <a class="replay-cell-link" href={replay.videoUrl} target="_blank" rel="noopener noreferrer">
              {replay.creator}
            </a>
          </td>
          <td data-label="Date" data-sort-value={replay.publishedAtTimestamp}>
            <a class="replay-cell-link" href={replay.videoUrl} target="_blank" rel="noopener noreferrer">
              <span title={replay.publishedAt}>{replay.publishedAtLabel || "-"}</span>
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  document.querySelectorAll("[data-curated-sortable]").forEach((wrapper) => {
    if (wrapper.dataset.sortEnhanced === "true") return;
    wrapper.dataset.sortEnhanced = "true";

    const table = wrapper.querySelector("table");
    const body = table?.querySelector("tbody");
    const buttons = Array.from(wrapper.querySelectorAll("[data-curated-sort-key]"));
    const headers = Array.from(wrapper.querySelectorAll("[data-curated-sort-header]"));
    if (!body) return;

    const sortState = { key: "damage", direction: "desc" };
    const numericKeys = new Set(["damage", "tier", "publishedAt"]);

    const updateHeaders = () => {
      headers.forEach((header) => {
        const active = header.dataset.curatedSortHeader === sortState.key;
        header.setAttribute("aria-sort", active ? (sortState.direction === "asc" ? "ascending" : "descending") : "none");
      });
      buttons.forEach((button) => {
        button.dataset.sortDirection = button.dataset.curatedSortKey === sortState.key ? sortState.direction : "";
      });
    };

    const sortRows = (columnIndex) => {
      const rows = Array.from(body.querySelectorAll("tr"));
      rows.sort((rowA, rowB) => {
        const valueA = rowA.cells[columnIndex]?.dataset.sortValue || "";
        const valueB = rowB.cells[columnIndex]?.dataset.sortValue || "";
        const comparison = numericKeys.has(sortState.key)
          ? Number(valueA) - Number(valueB)
          : valueA.localeCompare(valueB, undefined, { numeric: true, sensitivity: "base" });
        if (comparison !== 0) return sortState.direction === "asc" ? comparison : -comparison;

        const damageA = Number(rowA.cells[2]?.dataset.sortValue || 0);
        const damageB = Number(rowB.cells[2]?.dataset.sortValue || 0);
        return damageB - damageA;
      });
      rows.forEach((row) => body.append(row));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.dataset.curatedSortKey;
        const columnIndex = Number(button.dataset.columnIndex);
        if (!key || !Number.isInteger(columnIndex)) return;

        if (sortState.key === key) {
          sortState.direction = sortState.direction === "asc" ? "desc" : "asc";
        } else {
          sortState.key = key;
          sortState.direction = key === "damage" ? "desc" : "asc";
        }

        sortRows(columnIndex);
        updateHeaders();
      });
    });

    updateHeaders();
  });

  document.querySelectorAll("[data-replay-url]").forEach((row) => {
    if (row.dataset.replayRowEnhanced === "true") return;
    row.dataset.replayRowEnhanced = "true";
    row.addEventListener("click", (event) => {
      if (event.target.closest("a")) return;
      const replayUrl = row.dataset.replayUrl;
      if (replayUrl) window.open(replayUrl, "_blank", "noopener,noreferrer");
    });
  });
</script>

<style is:global>
  .table-wrap {
    -webkit-overflow-scrolling: touch;
    border: 1px solid #333;
    border-radius: 8px;
    box-sizing: border-box;
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
  }

  .replay-table {
    width: 100%;
    min-width: 1040px;
    border-collapse: collapse;
    background: #121212;
  }

  .replay-table th,
  .replay-table td {
    border-bottom: 1px solid #333;
    color: #cccccc;
    text-align: left;
    vertical-align: middle;
  }

  .replay-row.tier-divider-before td {
    border-top: 3px solid #d4af37;
  }

  .replay-table th {
    background: #252525;
    color: #d4af37;
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    padding: 0.75rem;
    text-transform: uppercase;
  }

  .sort-button {
    align-items: center;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    gap: 0.35rem;
    justify-content: inherit;
    letter-spacing: inherit;
    padding: 0;
    text-align: inherit;
    text-transform: inherit;
  }

  .sort-button::after {
    color: #f5d76e;
    content: "";
    display: inline-block;
    font-size: 0.8rem;
    line-height: 1;
    min-width: 0.7rem;
  }

  .sort-button[data-sort-direction="asc"]::after {
    content: "^";
  }

  .sort-button[data-sort-direction="desc"]::after {
    content: "v";
  }

  .sort-button:hover,
  .sort-button:focus-visible {
    color: #f5f5f5;
    outline: none;
  }

  .replay-row {
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .replay-row:hover,
  .replay-row:focus-within {
    background: #202020;
    outline: none;
  }

  .replay-row:hover td,
  .replay-row:focus-within td {
    color: #f5f5f5;
  }

  .replay-table td:nth-child(1),
  .replay-table td:nth-child(2),
  .replay-table td:nth-child(3),
  .replay-table td:nth-child(4),
  .replay-table td:nth-child(5),
  .replay-table td:nth-child(6),
  .replay-table td:nth-child(7),
  .replay-table td:nth-child(8),
  .replay-table td:nth-child(10) {
    white-space: nowrap;
  }

  .replay-table th:nth-child(1),
  .replay-table td:nth-child(1),
  .replay-table th:nth-child(2),
  .replay-table td:nth-child(2),
  .replay-table th:nth-child(3),
  .replay-table td:nth-child(3),
  .replay-table th:nth-child(4),
  .replay-table td:nth-child(4),
  .replay-table th:nth-child(5),
  .replay-table td:nth-child(5),
  .replay-table th:nth-child(6),
  .replay-table td:nth-child(6),
  .replay-table th:nth-child(7),
  .replay-table td:nth-child(7),
  .replay-table th:nth-child(8),
  .replay-table td:nth-child(8),
  .replay-table th:nth-child(10),
  .replay-table td:nth-child(10) {
    width: 1%;
  }

  .replay-cell-link,
  .replay-cell-content {
    align-items: center;
    color: inherit;
    display: flex;
    min-height: 3.25rem;
    padding: 0.75rem;
    text-decoration: none;
  }

  .replay-table th:nth-child(1),
  .replay-table th:nth-child(2),
  .replay-table th:nth-child(5) {
    text-align: center;
  }

  .replay-table td:nth-child(1) .replay-cell-content,
  .replay-table td:nth-child(2) .replay-cell-content,
  .replay-table td:nth-child(5) .replay-cell-content {
    justify-content: center;
    width: max-content;
  }

  .replay-table th:nth-child(6) {
    padding-right: 0.2rem;
  }

  .replay-table th:nth-child(7) {
    padding-left: 0.2rem;
    padding-right: 0.8rem;
  }

  .replay-table th:nth-child(8) {
    padding-left: 0.8rem;
    padding-right: 0.2rem;
  }

  .replay-table th:nth-child(9) {
    padding-left: 0.2rem;
  }

  .replay-table td:nth-child(6) .replay-cell-content {
    padding-right: 0.15rem;
    width: max-content;
  }

  .replay-table td:nth-child(7) .replay-cell-content {
    padding-left: 0.15rem;
    padding-right: 0.8rem;
    width: max-content;
  }

  .replay-table td:nth-child(8) .replay-cell-link {
    justify-content: center;
    padding-left: 0.8rem;
    padding-right: 0.2rem;
    width: max-content;
  }

  .replay-table td:nth-child(9) .replay-cell-link {
    padding-left: 0.2rem;
    width: max-content;
  }

  .replay-table td:nth-child(10) .replay-cell-link {
    width: max-content;
  }

  .tier-cell {
    gap: 0.45rem;
  }

  .replay-cell-link:focus-visible {
    color: #f5f5f5;
    outline: 2px solid rgba(212, 175, 55, 0.45);
    outline-offset: -2px;
  }

  .replay-table td:nth-child(3) .replay-cell-link:hover,
  .replay-table td:nth-child(3) .replay-cell-link:focus-visible,
  .replay-table td:nth-child(4) .replay-cell-link:hover,
  .replay-table td:nth-child(4) .replay-cell-link:focus-visible,
  .replay-table td:nth-child(9) .replay-cell-link:hover,
  .replay-table td:nth-child(9) .replay-cell-link:focus-visible,
  .replay-table td:nth-child(10) .replay-cell-link:hover,
  .replay-table td:nth-child(10) .replay-cell-link:focus-visible {
    color: #d4af37;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .hero-icons {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 220px;
  }

  .replay-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    position: relative;
  }

  .replay-icon {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    object-fit: contain;
  }

  .labeled-icon-wrap::after {
    background: #121212;
    border: 1px solid #d4af37;
    border-radius: 6px;
    bottom: calc(100% + 0.4rem);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45);
    color: #f5f5f5;
    content: attr(data-icon-title);
    font-size: 0.78rem;
    font-weight: 700;
    left: 50%;
    line-height: 1;
    opacity: 0;
    padding: 0.35rem 0.45rem;
    pointer-events: none;
    position: absolute;
    transform: translateX(-50%) translateY(0.2rem);
    transition: opacity 0.12s ease, transform 0.12s ease;
    visibility: hidden;
    white-space: nowrap;
    z-index: 65;
  }

  .labeled-icon-wrap:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    visibility: visible;
  }

  .map-preview-wrap {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    position: relative;
  }

  .map-preview {
    background: #121212;
    border: 1px solid #d4af37;
    border-radius: 8px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55);
    left: 50%;
    opacity: 0;
    padding: 0.35rem;
    pointer-events: none;
    position: absolute;
    top: calc(100% + 0.45rem);
    transform: translateX(-50%) scale(0.96);
    transition: opacity 0.15s ease, transform 0.15s ease;
    visibility: hidden;
    z-index: 60;
  }

  .map-preview img {
    border-radius: 6px;
    display: block;
    height: auto;
    max-width: 150px;
    width: 150px;
  }

  .map-preview-wrap:hover .map-preview,
  .replay-cell-link:focus-visible .map-preview,
  .replay-cell-content:focus-visible .map-preview {
    opacity: 1;
    transform: translateX(-50%) scale(1);
    visibility: visible;
  }

  .youtube-logo {
    display: block;
    height: 20px;
    object-fit: contain;
    width: 28px;
  }

  .icon-fallback {
    color: #f5f5f5;
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
