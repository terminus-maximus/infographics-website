---
const { bosses = [], teams = [], tiers = [] } = Astro.props;
---

<section class="content-section replay-library-panel replay-library-filters" aria-labelledby="replay-filters-heading">
  <h2 id="replay-filters-heading">Replay Filters</h2>

  <form class="filters-grid" data-replay-filters>
    <label class="filter-field">
      <span>Boss</span>
      <select name="boss" data-filter="boss">
        <option value="">Select a Boss</option>
        {bosses.map((boss) => (
          <option value={boss.value}>{boss.label}</option>
        ))}
      </select>
    </label>

    <label class="filter-field" data-dependent-filter hidden>
      <span>Team</span>
      <select name="team" data-filter="team" disabled>
        <option value="">All Teams</option>
        {teams.map((team) => (
          <option value={team}>{team}</option>
        ))}
      </select>
    </label>

    <label class="filter-field" data-dependent-filter hidden>
      <span>Tier</span>
      <select name="tier" data-filter="tier" disabled>
        <option value="">All Tiers</option>
        {tiers.map((tier) => (
          <option value={tier}>{tier}</option>
        ))}
      </select>
    </label>

    <label class="filter-field" data-dependent-filter hidden>
      <span>Map</span>
      <select name="map" data-filter="map" disabled>
        <option value="">All Maps</option>
      </select>
    </label>

    <div class="filter-field hero-filter-field" data-dependent-filter hidden>
      <span>Included Heroes</span>
      <button
        class="hero-dropdown-toggle"
        type="button"
        data-hero-toggle="includedHeroes"
        aria-expanded="false"
        disabled
      >
        Select a Team first
      </button>
      <div class="hero-dropdown-menu" data-hero-menu="includedHeroes" hidden>
        <p>Select a Team first</p>
      </div>
    </div>

    <div class="filter-field hero-filter-field" data-dependent-filter hidden>
      <span>Excluded Heroes</span>
      <button
        class="hero-dropdown-toggle"
        type="button"
        data-hero-toggle="excludedHeroes"
        aria-expanded="false"
        disabled
      >
        Select a Team first
      </button>
      <div class="hero-dropdown-menu" data-hero-menu="excludedHeroes" hidden>
        <p>Select a Team first</p>
      </div>
    </div>
  </form>
</section>

<style>
  .filters-grid {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .filter-field {
    color: #cccccc;
    display: flex;
    flex-direction: column;
    font-weight: 600;
    gap: 0.45rem;
    position: relative;
    width: fit-content;
  }

  .filter-field span {
    color: #aaaaaa;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  select,
  .hero-dropdown-toggle {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-sizing: border-box;
    color: #f5f5f5;
    font-family: inherit;
    font-size: 1rem;
    min-height: 2.75rem;
    padding: 0.7rem 0.8rem;
  }

  select:disabled,
  .hero-dropdown-toggle:disabled {
    color: #777;
    cursor: not-allowed;
    opacity: 0.7;
  }

  select:focus-visible,
  .hero-dropdown-toggle:focus-visible {
    border-color: #d4af37;
    outline: 2px solid rgba(212, 175, 55, 0.25);
    outline-offset: 2px;
  }

  [data-filter="boss"] {
    width: 10rem;
  }

  [data-filter="map"] {
    width: 10.5rem;
  }

  [data-filter="team"] {
    width: 11rem;
  }

  [data-filter="tier"] {
    width: 8rem;
  }

  .hero-dropdown-toggle {
    cursor: pointer;
    text-align: left;
    width: 13.5rem;
  }

  .hero-dropdown-toggle::after {
    color: #d4af37;
    content: "v";
    float: right;
    font-size: 0.8rem;
    margin-left: 1rem;
  }

  .hero-dropdown-menu {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    left: 0;
    margin-top: 0.35rem;
    max-height: 16rem;
    min-width: 13.5rem;
    overflow-y: auto;
    padding: 0.45rem;
    position: absolute;
    top: 100%;
    width: max-content;
    z-index: 20;
  }

  .hero-dropdown-menu p {
    color: #888;
    margin: 0;
    padding: 0.6rem 0.7rem;
  }

  :global(.hero-checkbox-option) {
    align-items: center;
    border-radius: 6px;
    color: #cccccc;
    cursor: pointer;
    display: flex;
    gap: 0.55rem;
    padding: 0.45rem 0.55rem;
    white-space: nowrap;
  }

  :global(.hero-checkbox-option:hover),
  :global(.hero-checkbox-option:focus-within) {
    background: #202020;
    color: #f5f5f5;
  }

  :global(.hero-checkbox-option input) {
    accent-color: #d4af37;
    margin: 0;
  }

  @media (max-width: 700px) {
    .filters-grid {
      display: flex;
    }
  }
</style>
