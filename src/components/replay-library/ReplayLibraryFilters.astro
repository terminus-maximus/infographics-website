---
import teamArchetypes from "../../data/replay-library/team_archetype.json";

const { bosses = [], teams = [], tiers = [] } = Astro.props;

const teamIconByName = Object.fromEntries(
  teamArchetypes.map((team) => [team.team_archetype, team.team_icon])
);

const getBossIconName = (boss) => boss.value.replaceAll(" ", "_");
---

<section class="content-section replay-library-panel replay-library-filters" aria-labelledby="replay-filters-heading">
  <h2 id="replay-filters-heading">Replay Filters</h2>

  <form class="filters-grid" data-replay-filters>
    <div class="filter-field choice-filter-field">
      <span>Boss</span>
      <button
        class="choice-toggle"
        type="button"
        data-choice-toggle="boss"
        data-filter="boss"
        aria-expanded="false"
      >
        <span class="choice-placeholder">Select a Boss</span>
      </button>
      <div class="choice-menu" data-choice-menu="boss" hidden>
        {bosses.map((boss) => (
          <button class="choice-option" type="button" data-choice-option="boss" data-value={boss.value}>
            <img
              class="choice-icon"
              src={`/images/replay-library/bosses/${getBossIconName(boss)}.webp`}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              onerror="this.hidden=true;"
            />
            <span>{boss.label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="filter-field choice-filter-field">
      <span>Team</span>
      <button
        class="choice-toggle"
        type="button"
        data-choice-toggle="team"
        data-filter="team"
        aria-expanded="false"
      >
        <span class="choice-placeholder">All Teams</span>
      </button>
      <div class="choice-menu" data-choice-menu="team" hidden>
        <button class="choice-option" type="button" data-choice-option="team" data-value="">
          <span class="choice-icon choice-icon-empty" aria-hidden="true"></span>
          <span>All Teams</span>
        </button>
        {teams.map((team) => (
          <button class="choice-option" type="button" data-choice-option="team" data-value={team}>
            <img
              class="choice-icon"
              src={`/images/replay-library/heroes/${teamIconByName[team] || team}.webp`}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              onerror="this.hidden=true;"
            />
            <span>{team}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="filter-field choice-filter-field" data-dependent-filter hidden>
      <span>Map</span>
      <button
        class="choice-toggle"
        type="button"
        data-choice-toggle="map"
        data-filter="map"
        aria-expanded="false"
        disabled
      >
        <span class="choice-toggle-content">
          <span class="choice-icon choice-icon-empty" aria-hidden="true"></span>
          <span>All Maps</span>
        </span>
      </button>
      <div class="choice-menu" data-choice-menu="map" hidden>
        <button class="choice-option" type="button" data-choice-option="map" data-value="">
          <span class="choice-icon choice-icon-empty" aria-hidden="true"></span>
          <span>All Maps</span>
        </button>
      </div>
    </div>

    <div class="filter-field choice-filter-field" data-dependent-filter hidden>
      <span>Tier</span>
      <button
        class="choice-toggle choice-toggle-plain"
        type="button"
        data-choice-toggle="tier"
        data-filter="tier"
        aria-expanded="false"
        disabled
      >
        <span class="choice-toggle-content">
          <span class="choice-icon choice-icon-empty" aria-hidden="true"></span>
          <span>All Tiers</span>
        </span>
      </button>
      <div class="choice-menu" data-choice-menu="tier" hidden>
        <button class="choice-option" type="button" data-choice-option="tier" data-value="">
          <span class="choice-icon choice-icon-empty" aria-hidden="true"></span>
          <span>All Tiers</span>
        </button>
        {tiers.map((tier) => (
          <button class="choice-option" type="button" data-choice-option="tier" data-value={tier}>
            <img
              class="choice-icon"
              src={`/images/replay-library/tier/${tier.startsWith("M") ? "mythic" : "legendary"}.webp`}
              width="28"
              height="28"
              alt=""
              loading="lazy"
              onerror="this.hidden=true;"
            />
            <span>{tier}</span>
          </button>
        ))}
      </div>
    </div>

    <details class="more-filters" data-more-filters data-dependent-filter hidden>
      <summary>More Filters</summary>

      <div class="more-filters-panel">
        <div class="filter-field hero-filter-field">
          <span>Included Heroes</span>
          <button
            class="hero-dropdown-toggle"
            type="button"
            data-hero-toggle="includedHeroes"
            aria-expanded="false"
            disabled
          >
            Select a Team first
          </button>
          <div class="hero-dropdown-menu" data-hero-menu="includedHeroes" hidden>
            <p>Select a Team first</p>
          </div>
        </div>

        <div class="filter-field hero-filter-field">
          <span>Excluded Heroes</span>
          <button
            class="hero-dropdown-toggle"
            type="button"
            data-hero-toggle="excludedHeroes"
            aria-expanded="false"
            disabled
          >
            Select a Team first
          </button>
          <div class="hero-dropdown-menu" data-hero-menu="excludedHeroes" hidden>
            <p>Select a Team first</p>
          </div>
        </div>

        <label class="filter-field range-filter-field">
          <span>Minimum Damage</span>
          <input
            class="range-filter"
            type="range"
            min="0"
            max="2000000"
            step="10000"
            value="0"
            data-filter="minimumDamage"
          />
          <output class="range-filter-value" data-minimum-damage-value>No floor</output>
        </label>

        <label class="filter-field date-filter-field">
          <span>Minimum Date</span>
          <input
            class="date-filter"
            type="date"
            data-filter="minimumDate"
            aria-label="Minimum published date"
          />
        </label>
      </div>
    </details>
  </form>
</section>

<style>
  .filters-grid {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .filter-field {
    color: #cccccc;
    display: flex;
    flex-direction: column;
    font-weight: 600;
    gap: 0.45rem;
    position: relative;
    width: fit-content;
  }

  .filter-field > span {
    color: #aaaaaa;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .choice-toggle,
  .hero-dropdown-toggle {
    align-items: center;
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-sizing: border-box;
    color: #f5f5f5;
    cursor: pointer;
    display: inline-flex;
    font-family: inherit;
    font-size: 1rem;
    gap: 0.55rem;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: 0.7rem 0.8rem;
    text-align: left;
    width: 12rem;
  }

  .choice-toggle:disabled,
  .hero-dropdown-toggle:disabled {
    color: #777;
    cursor: not-allowed;
    opacity: 0.7;
  }

  .choice-toggle:focus-visible,
  .hero-dropdown-toggle:focus-visible {
    border-color: #d4af37;
    outline: 2px solid rgba(212, 175, 55, 0.25);
    outline-offset: 2px;
  }

  .choice-toggle::after,
  .hero-dropdown-toggle::after {
    color: #d4af37;
    content: "v";
    font-size: 0.8rem;
    margin-left: auto;
  }

  .choice-toggle[aria-expanded="true"]::after,
  .hero-dropdown-toggle[aria-expanded="true"]::after {
    content: "^";
  }

  .choice-toggle-content {
    align-items: center;
    display: inline-flex;
    gap: 0.55rem;
    min-width: 0;
  }

  .choice-toggle-content span,
  .choice-placeholder {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .choice-menu {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    left: 0;
    margin-top: 0.35rem;
    max-height: min(20rem, 65vh);
    min-width: 100%;
    overflow-y: auto;
    padding: 0.35rem;
    position: absolute;
    top: 100%;
    width: max-content;
    z-index: 30;
  }

  .choice-option {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 6px;
    color: #cccccc;
    cursor: pointer;
    display: flex;
    font: inherit;
    gap: 0.55rem;
    padding: 0.45rem 0.55rem;
    text-align: left;
    width: 100%;
    white-space: nowrap;
  }

  .choice-option:hover,
  .choice-option:focus-visible,
  .choice-option[aria-selected="true"] {
    background: #202020;
    color: #f5f5f5;
    outline: none;
  }

  .choice-icon {
    border-radius: 6px;
    display: block;
    flex: 0 0 28px;
    height: 28px;
    object-fit: contain;
    width: 28px;
  }

  .choice-icon-empty {
    border: 1px dashed #444;
    box-sizing: border-box;
  }

  [data-choice-menu="map"] .choice-option {
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
  }

  [data-choice-menu="map"] .choice-icon {
    flex-basis: 112px;
    height: 112px;
    width: 112px;
  }

  .hero-dropdown-menu {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    box-sizing: border-box;
    left: 0;
    margin-top: 0.35rem;
    max-height: 16rem;
    min-width: 13.5rem;
    overflow-y: auto;
    padding: 0.45rem;
    position: absolute;
    top: 100%;
    width: max-content;
    z-index: 20;
  }

  .more-filters {
    align-self: end;
    position: relative;
  }

  .more-filters summary {
    align-items: center;
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-sizing: border-box;
    color: #f5f5f5;
    cursor: pointer;
    display: inline-flex;
    font-weight: 700;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    user-select: none;
  }

  .more-filters summary::marker,
  .more-filters summary::-webkit-details-marker {
    display: none;
  }

  .more-filters summary::after {
    color: #d4af37;
    content: "v";
    font-size: 0.8rem;
  }

  .more-filters[open] summary::after {
    content: "^";
  }

  .more-filters-panel {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 0.8rem;
    position: absolute;
    right: 0;
    z-index: 15;
  }

  .date-filter-field {
    min-width: 13.5rem;
  }

  .range-filter-field {
    min-width: 8.5rem;
  }

  .range-filter-value {
    color: #f5f5f5;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .range-filter {
    accent-color: #d4af37;
    min-height: 2.75rem;
    width: 8.5rem;
  }

  .date-filter {
    background: #121212;
    border: 1px solid #333;
    border-radius: 8px;
    box-sizing: border-box;
    color: #f5f5f5;
    color-scheme: dark;
    font-family: inherit;
    font-size: 1rem;
    min-height: 2.75rem;
    padding: 0.7rem 0.8rem;
    width: 13.5rem;
  }

  .date-filter:focus-visible {
    border-color: #d4af37;
    outline: 2px solid rgba(212, 175, 55, 0.25);
    outline-offset: 2px;
  }

  .hero-dropdown-menu p {
    color: #888;
    margin: 0;
    padding: 0.6rem 0.7rem;
  }

  :global(.hero-checkbox-option) {
    align-items: center;
    border-radius: 6px;
    color: #cccccc;
    cursor: pointer;
    display: flex;
    gap: 0.55rem;
    padding: 0.45rem 0.55rem;
    white-space: nowrap;
  }

  :global(.hero-checkbox-option:hover),
  :global(.hero-checkbox-option:focus-within) {
    background: #202020;
    color: #f5f5f5;
  }

  :global(.hero-checkbox-option input) {
    accent-color: #d4af37;
    margin: 0;
  }

  @media (max-width: 700px) {
    .filters-grid {
      display: flex;
    }

    .filter-field,
    .choice-toggle,
    .more-filters,
    .more-filters summary,
    .more-filters-panel,
    .hero-dropdown-toggle,
    .range-filter,
    .date-filter {
      width: 100%;
    }

    .choice-filter-field,
    .hero-filter-field,
    .range-filter-field,
    .date-filter-field {
      min-width: min(100%, 16rem);
    }

    .choice-menu,
    .hero-dropdown-menu {
      max-width: calc(100vw - 3.5rem);
      width: 100%;
    }

    .more-filters-panel {
      flex-direction: column;
      position: static;
    }
  }
</style>
