<section
  class="content-section replay-library-panel replay-statistics"
  aria-labelledby="replay-statistics-heading"
  data-replay-statistics
>
  <h2 id="replay-statistics-heading">Live Statistics</h2>

  <div class="stat-grid">
    <div class="stat-card">
      <span class="stat-label">Matching Replays</span>
      <strong data-stat="matchingReplays">0</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Highest Damage</span>
      <strong data-stat="highestDamage">-</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Average Damage</span>
      <strong data-stat="averageDamage">-</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Unique Creators</span>
      <strong data-stat="uniqueCreators">0</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Unique Maps</span>
      <strong data-stat="uniqueMaps">0</strong>
    </div>
  </div>
</section>
