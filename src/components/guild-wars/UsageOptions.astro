---
import UnitPortrait from './UnitPortrait.astro';
import { number, percent, type Usage } from '../../lib/guildWars';
interface Props { options: Usage[]; compact?: boolean }
const { options, compact = false } = Astro.props;
---
<ul class:list={['usage-options', { compact }]}>
  {options.map(option => <li>
    <UnitPortrait id={option.unit} compact={compact} />
    <span class="usage"><strong>{percent(option.share)}</strong><span>{number(option.attempts)} attacks</span></span>
  </li>)}
</ul>
<style>
  .usage-options { display: flex; flex-wrap: wrap; gap: .75rem; padding: 0; margin: 0; list-style: none; }
  li { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: .6rem; background: #161616; border: 1px solid #333; border-radius: 8px; padding: .85rem .4rem; width: 118px; }
  li :global(.unit-name) { font-size: .8rem; }
  .usage { display: flex; flex-direction: column; gap: .2rem; text-align: center; font-size: .75rem; color: #aaa; }
  .usage strong { color: #f5d76e; font-weight: 500; font-size: 1rem; }
  .compact { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .compact li { width: auto; flex-direction: row; padding: .6rem; gap: .8rem; }
  .compact .usage { flex-shrink: 0; text-align: right; }
  @media(max-width: 480px) { .usage-options:not(.compact) { gap: .5rem; } li { width: calc((100% - 1rem) / 3); min-width: 0; } li :global(.unit) { max-width: 100%; } .compact { grid-template-columns: minmax(0,1fr); } }
</style>
