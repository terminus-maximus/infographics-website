---
import discussionData from "../data/relatedDiscussions.json";
import discussionPolicy from "../data/relatedDiscussionPolicy.json";
import { selectRelatedDiscussions } from "../lib/relatedDiscussions.mjs";

interface Props {
  pathname?: string;
}

const pathname = Astro.props.pathname || Astro.url.pathname;
const discussions = selectRelatedDiscussions(discussionData, discussionPolicy, pathname);
---

{discussions.length > 0 && (
  <section class="related-discussions" aria-labelledby="related-discussions-heading">
    <h2 id="related-discussions-heading">Related Discussions</h2>
    <ul>
      {discussions.map((discussion) => (
        <li>
          <a href={discussion.url} title={discussion.title} target="_blank" rel="noopener noreferrer">
            {discussion.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-discussions {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    margin-top: 4rem;
    padding: 1.5rem;
  }

  h2 {
    border-bottom: 1px solid #333;
    color: #d4af37;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
  }

  ul {
    color: #cccccc;
    line-height: 1.7;
    margin: 0;
    padding-left: 1.5rem;
  }

  a {
    color: #d4af37;
    overflow-wrap: anywhere;
  }

  a:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .related-discussions { padding: 1rem; }
  }
</style>
