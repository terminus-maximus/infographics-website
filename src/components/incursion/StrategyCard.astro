---
import RequiredHeroIcons from "../campaign/RequiredHeroIcons.astro";
import { characterReferences } from "../../lib/campaigns";
import type { IncursionStrategy } from "../../data/incursion/types";

interface Props { strategy: IncursionStrategy; number: number }
const { strategy, number } = Astro.props;
const heroes = (ids: string[]) => ids.map((id) => characterReferences[id]);
---

<article class:list={["strategy-card", { featured: strategy.recommended }]} id={strategy.id} aria-labelledby={`${strategy.id}-heading`}>
  <header>
    <span class="strategy-number" aria-hidden="true">{String(number).padStart(2, "0")}</span>
    <div>
      <div class="title-row"><h3 id={`${strategy.id}-heading`}>{strategy.name}</h3><span class="strategy-tag">{strategy.tag}</span></div>
      <p class="fit">{strategy.fit}</p>
    </div>
  </header>
  <div class="strategy-body">
    <div class="roster">
      <h4>Core heroes</h4>
      <p class="core-summary">{strategy.coreSummary}</p>
      <div class="core-portraits" data-core-count={strategy.core.length}>
        <RequiredHeroIcons heroes={heroes(strategy.core)} showNames label={`${strategy.name} core heroes`} />
      </div>
      <div class="flex-roster">
        <h4>Flex choices <span>· fit your roster</span></h4>
        <div class="flex-portraits">
          {strategy.featuredFlex && (
            <div class="featured-flex">
              <RequiredHeroIcons heroes={heroes([strategy.featuredFlex.id])} showNames label={`${strategy.name} leading flex option`} />
              <span class="flex-label">{strategy.featuredFlex.label}</span>
            </div>
          )}
          {strategy.flex.length > 0 && <RequiredHeroIcons heroes={heroes(strategy.flex)} showNames label={`${strategy.name} flex options`} />}
        </div>
        <p class="flex-summary">{strategy.flexSummary}</p>
      </div>
    </div>
    <div class="play-pattern">
      <h4>How to play</h4>
      <p class="principle">{strategy.principle}</p>
      <p>{strategy.explanation}</p>
      {strategy.caveat && <p class="caveat">{strategy.caveat}</p>}
      {strategy.otherOptions && (
        <details class="other-options">
          <summary>Other demonstrated options</summary>
          <RequiredHeroIcons heroes={heroes(strategy.otherOptions.ids)} showNames label="Other demonstrated options" />
          <p>{strategy.otherOptions.note}</p>
        </details>
      )}
    </div>
  </div>
  <footer class="strategy-evidence">
    <p><strong>What the evidence shows</strong> {strategy.evidence}</p>
    <a href={`#evidence-${strategy.evidenceCreator}`}>Creator evidence <span aria-hidden="true">↓</span></a>
  </footer>
</article>

<style>
  .strategy-card { min-width: 0; overflow: hidden; border: 1px solid var(--guide-border); border-radius: 9px; background: var(--guide-soft); scroll-margin-top: 6rem; }
  .featured { border-color: #5b4b1c; }
  header { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--guide-border); background: var(--guide-soft); }
  .featured header { background: var(--guide-accent-soft); }
  .strategy-number { display: grid; flex: 0 0 2.7rem; height: 2.7rem; place-items: center; border: 1px solid #5b4b1c; border-radius: 50%; background: var(--guide-accent-soft); color: var(--guide-accent-hover); font-size: .9rem; font-weight: 600; }
  .title-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; }
  h3 { margin: 0; font-size: 1.45rem; letter-spacing: -.025em; }
  .strategy-tag { color: var(--guide-accent); font-size: .75rem; font-weight: 600; }
  p { margin: 0; font-size: .93rem; line-height: 1.75; }
  .fit { margin-top: .3rem; color: var(--guide-muted); font-size: .88rem; }
  .strategy-body { display: grid; grid-template-columns: 1.15fr 1fr; gap: 2rem; padding: 1.5rem; }
  .roster, .play-pattern { min-width: 0; }
  h4 { margin: 0 0 .55rem; color: var(--guide-accent); font-size: .73rem; font-weight: 600; text-transform: uppercase; letter-spacing: .075em; }
  h4 span { color: var(--guide-muted); font-weight: 400; text-transform: none; letter-spacing: 0; }
  .core-summary { font-size: .9rem; font-weight: 600; }
  .core-portraits { --hero-portrait-size: 76px; --hero-portrait-border: rgba(212, 175, 55, .55); }
  .flex-roster { margin-top: 1.35rem; padding-top: 1.1rem; border-top: 1px solid var(--guide-border); }
  .flex-portraits { display: flex; flex-wrap: wrap; align-items: flex-start; gap: .7rem; --hero-portrait-size: 50px; }
  .featured-flex { display: flex; align-items: center; gap: .65rem; padding: 0 .7rem .65rem; border: 1px solid #5b4b1c; border-radius: 8px; background: var(--guide-accent-soft); --hero-portrait-size: 58px; }
  .flex-label { max-width: 7rem; color: var(--guide-accent); font-size: .72rem; line-height: 1.5; font-weight: 600; }
  .flex-summary { margin-top: .8rem; color: var(--guide-muted); font-size: .83rem; }
  .principle { margin-bottom: .6rem; font-size: 1.17rem; font-weight: 600; line-height: 1.5; }
  .caveat { margin-top: 1rem; padding-left: .85rem; border-left: 3px solid var(--guide-accent); color: var(--guide-muted); font-size: .82rem; }
  .strategy-evidence { display: flex; align-items: center; gap: 1.5rem; padding: 1rem 1.5rem; border-top: 1px solid var(--guide-border); background: var(--guide-soft); }
  .strategy-evidence p { color: var(--guide-muted); font-size: .8rem; }
  .strategy-evidence strong { color: var(--guide-ink); }
  .strategy-evidence a { flex-shrink: 0; color: var(--guide-accent); font-size: .8rem; font-weight: 600; text-underline-offset: .2em; }
  .other-options { margin-top: 1rem; color: var(--guide-muted); --hero-portrait-size: 42px; }
  summary { padding: .5rem 0; color: var(--guide-accent); cursor: pointer; font-size: .85rem; }
  .other-options p { margin-top: .75rem; font-size: .82rem; }
  @media (max-width: 800px) {
    .strategy-body { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; }
    .strategy-evidence { flex-direction: column; align-items: flex-start; gap: .65rem; }
  }
  @media (max-width: 480px) {
    header, .strategy-body, .strategy-evidence { padding: 1rem; }
    header { gap: .7rem; align-items: flex-start; }
    h3 { font-size: 1.25rem; }
    .core-portraits { --hero-portrait-size: 62px; }
    .flex-portraits { --hero-portrait-size: 46px; }
  }
  @media (max-width: 400px) {
    .core-portraits[data-core-count="4"] :global(.required-heroes) { display: grid; grid-template-columns: repeat(2, max-content); gap: .9rem 1.15rem; }
  }
  @media (max-width: 360px) {
    .core-portraits[data-core-count="3"] { --hero-portrait-size: 50px; }
    .flex-portraits > :global(.required-heroes) { display: grid; grid-template-columns: repeat(2, max-content); }
  }
</style>
