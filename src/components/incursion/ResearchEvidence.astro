---
import type { IncursionGuide } from "../../data/incursion/types";
interface Props { research: IncursionGuide["research"] }
const { research } = Astro.props;
const uploadCount = research.creators.reduce((total, creator) => total + creator.uploads, 0);
---
<section class="guide-panel" id="research" aria-labelledby="research-heading">
  <div class="research-title">
    <h2 id="research-heading">Why We Recommend These Teams</h2>
    <p class="research-count">{research.creators.length} creators <span aria-hidden="true">·</span> {uploadCount} uploads</p>
  </div>
  <p class="section-intro">{research.summary}</p>
  <ul class="findings">{research.findings.map((finding) => <li>{finding}</li>)}</ul>
  <div class="evidence-grid">
    {research.creators.map((creator) => (
      <article id={`evidence-${creator.id}`} aria-labelledby={`creator-${creator.id}`}>
        <header><h3 id={`creator-${creator.id}`}>{creator.name}</h3><span>{creator.uploads} {creator.uploads === 1 ? "upload" : "uploads"}</span></header>
        <p class="tiers">{creator.tiers}</p>
        <p class="supports">Supports: {creator.supports}</p>
        <p>{creator.observation}</p>
        <details>
          <summary>Coverage &amp; limits</summary>
          <p>{creator.limitation}</p>
        </details>
        <ul class="evidence-links">
          {creator.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </article>
    ))}
  </div>
  <p class="research-limitations">{research.limitations}</p>
</section>
<style>
  .research-count { margin: -.25rem 0 1rem; color: var(--guide-accent); font-size: .82rem; font-weight: 600; }
  .findings { margin: 0 0 1.5rem; padding-left: 1.3rem; color: var(--guide-muted); font-size: .88rem; line-height: 1.7; }
  .findings li + li { margin-top: .5rem; }
  .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  article { display: flex; flex-direction: column; min-width: 0; padding: 1.25rem; border: 1px solid var(--guide-border); border-radius: 9px; background: var(--guide-soft); scroll-margin-top: 6rem; }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .6rem; }
  h3 { margin: 0; font-size: 1.05rem; }
  header span { color: var(--guide-muted); font-size: .75rem; }
  p { color: var(--guide-muted); font-size: .85rem; line-height: 1.75; }
  .tiers { margin: .4rem 0; font-size: .78rem; }
  .supports { margin: .35rem 0 0; color: var(--guide-accent); font-size: .78rem; font-weight: 600; }
  details { margin-bottom: 1rem; }
  summary { padding: .3rem 0; color: var(--guide-accent); font-size: .8rem; cursor: pointer; }
  details p { margin-bottom: 0; font-size: .8rem; }
  .evidence-links { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; margin: auto 0 0; padding: .85rem 0 0; border-top: 1px solid var(--guide-border); list-style: none; }
  a { color: var(--guide-accent); font-size: .8rem; text-underline-offset: .2em; }
  .research-limitations { margin: 1.25rem 0 0; font-size: .8rem; }
  @media (max-width: 700px) { .evidence-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
