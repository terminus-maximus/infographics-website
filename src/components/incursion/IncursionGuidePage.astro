---
import "../../styles/campaign-layout.css";
import "../../styles/heroes.css";
import "../../styles/incursion-guide.css";
import "../../styles/machine-profiles.css";
import Layout from "../../layouts/Layout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import MachineIdentity from "./MachineIdentity.astro";
import MachineAbilities from "./MachineAbilities.astro";
import InfographicUpdated from "../InfographicUpdated.astro";
import FeaturedInfographic from "../FeaturedInfographic.astro";
import StrategyCard from "./StrategyCard.astro";
import PowerUpPriorities from "./PowerUpPriorities.astro";
import ResearchEvidence from "./ResearchEvidence.astro";
import TierCapsRewards from "./TierCapsRewards.astro";
import StageTips from "./StageTips.astro";
import type { IncursionGuide } from "../../data/incursion/types";
import type { Machine } from "../../lib/machine-types";
import { machineHref } from "../../lib/machines.mjs";

interface Props { machine: Machine; guide?: IncursionGuide }
const { machine, guide } = Astro.props;
const trail = [{name:'Home',url:'/'},{name:'Incursion',url:'/incursion-mow/'},{name:machine.name,url:machineHref(machine)}];
const breadcrumbs = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:trail.map((crumb,index)=>({'@type':'ListItem',position:index+1,name:crumb.name,item:`https://terminusmaximus.com${crumb.url}`}))};
const tocGroups = guide ? [
  { title: "Guide", links: [{ label: "Overview", href: "#overview" }, { label: "Team Strategies", href: "#strategies" }, { label: "Power-Up Priorities", href: "#power-ups" }] },
  { title: "Team Strategies", links: guide.strategies.map((strategy) => ({ label: strategy.name, href: `#${strategy.id}` })) },
  { title: "Tips & Evidence", links: [{ label: "Rules for Success", href: "#rules" }, ...(guide.stageTips ? [{ label: "Stage-Specific Tips", href: "#stage-tips" }] : []), ...(guide.tierRewards?.length ? [{ label: "Tier Caps & Shard Rewards", href: "#tier-caps-rewards" }] : []), { label: "Creator Evidence", href: "#research" }] },
] : [];
---
<Layout title={`${machine.name} Machine of War Guide — Abilities & Rating | Terminus Maximus`} description={`${machine.name}: Active, Passive and Mythic abilities, adjustable levels and promotions, and Terminus Maximus's star rating.${guide ? ' Includes the Incursion unlock infographic and team strategies.' : ''}`}
  image={guide?.infographic?.src ?? machine.portrait.src} url={`https://terminusmaximus.com${machineHref(machine)}`}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g,'\u003c')} /></Fragment>
  <Header />
  <main class="campaign-page heroes-page incursion-guide mow-profile" id="guide-content">
    <nav class="hero-breadcrumbs" aria-label="Breadcrumb">{trail.map((crumb,index) => <><a href={crumb.url} aria-current={index === trail.length - 1 ? 'page' : undefined}>{crumb.name}</a>{index < trail.length - 1 && <span aria-hidden="true">/</span>}</>)}</nav>
    <MachineIdentity machine={machine} hasGuide={!!guide} />

    {guide?.infographic && <div id="unlock-guide"><FeaturedInfographic title={`${machine.name} Unlock Guide`} asset={guide.infographic} /><InfographicUpdated imageSrc={guide.infographic.fullSizeSrc} /></div>}

    <MachineAbilities machine={machine} />

    {guide && <>
    <nav class="table-of-contents guide-panel" aria-labelledby="table-of-contents-heading">
      <h2 id="table-of-contents-heading">Table of Contents</h2>
      <div class="toc-grid">
        {tocGroups.map((group) => (
          <div class="toc-group">
            <h3>{group.title}</h3>
            <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </nav>

    <section class="guide-panel" id="overview" aria-labelledby="overview-heading">
      <h2 id="overview-heading">Overview</h2>
      <p class="machine-meta">Machine: <strong>{guide.machine}</strong> · Eligible alliance: <strong>{guide.alliance}</strong></p>
      <p class="overview-headline">{guide.overview.headline}</p>
      <p class="section-intro">{guide.overview.text}</p>
      <div class="overview-principles">
        {guide.overview.principles.map((principle, index) => (
          <article><span class="principle-number" aria-hidden="true">0{index + 1}</span><h3>{principle.title}</h3><p>{principle.text}</p></article>
        ))}
      </div>
    </section>

    <section class="guide-panel strategies-section" id="strategies" aria-labelledby="strategies-heading">
      <h2 id="strategies-heading">Three Ways to Build for {guide.machine}</h2>
      <p class="section-intro">Start with the path that fits your account, build around its core heroes, then use flex slots to adapt it.</p>
      <p class="hero-guide-note"><strong><a href="/heroes/">Hero Guides</a>:</strong> Select a hero’s name or portrait in the strategies below for stats, abilities, traits and ratings.</p>
      <div class="strategy-list">{guide.strategies.map((strategy, index) => <StrategyCard strategy={strategy} number={index + 1} linkHeroes />)}</div>
    </section>

    <PowerUpPriorities powerUps={guide.powerUps} />

    <section class="guide-panel" id="rules" aria-labelledby="rules-heading">
      <h2 id="rules-heading">Rules for Success</h2>
      <ol class="rules-grid">
        {guide.rules.map((rule) => <li><h3>{rule.title}</h3><p>{rule.text}</p></li>)}
      </ol>
    </section>

    {guide.stageTips && <StageTips tips={guide.stageTips} />}

    {guide.tierRewards?.length ? <TierCapsRewards rows={guide.tierRewards} /> : null}

    <ResearchEvidence research={guide.research} />

    <nav class="guide-next" aria-label="Related guides">
      {guide.relatedGuides.map((link) => <a href={link.url}>{link.label}</a>)}
    </nav>
    </>}
    <nav class="machine-bottom-nav" aria-label="Machine of War navigation"><a href="/incursion-mow/#machines">← All Machines of War</a><a href="/heroes/">Explore Hero Guides →</a></nav>
  </main>
  <Footer />
</Layout>
<style>
  .hero-guide-note { margin: 0 0 1.5rem; color: var(--guide-muted); font-size: .85rem; line-height: 1.7; }
  .hero-guide-note a { color: var(--guide-accent); text-underline-offset: .2em; }
</style>
