---
import Layout from "../layouts/Layout.astro";

const target = "/guild-raid/s103";
---

<Layout
  title="Current Guild Raid Season | Terminus Maximus Infographics"
  description="Redirecting to the current Guild Raid season guide."
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </Fragment>

  <script is:inline define:vars={{ target }}>
  window.location.replace(target);
  </script>

  <p>
    Redirecting to <a href={target}>current Guild Raid guide</a>...
  </p>
</Layout>
