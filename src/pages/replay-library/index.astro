---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ReplayLibraryFilters from "../../components/replay-library/ReplayLibraryFilters.astro";
import ReplayStatistics from "../../components/replay-library/ReplayStatistics.astro";
import ReplayResultsTable from "../../components/replay-library/ReplayResultsTable.astro";
import { graphics } from "../../data/graphics";
import replayRows from "../../data/replay-library/PgC5E7jYNBPh8SoE9CGtXMH.json";
import bossRows from "../../data/replay-library/bosses.json";
import characterRows from "../../data/replay-library/characters.json";
import mapRows from "../../data/replay-library/maps_directory.json";
import teamTemplateRows from "../../data/replay-library/team_templates.json";
import teamArchetypeRows from "../../data/replay-library/team_archetype.json";
import { createReplayLibraryData } from "../../lib/replayLibrary";

const title = "Replay Library";
const description =
  "The largest public Guild Raid Replay collection, categorized by Boss, Map, Team, and Damage.";

const replayLibraryData = createReplayLibraryData(
  replayRows,
  bossRows,
  characterRows,
  mapRows,
  teamTemplateRows
);
const teamIconMap = Object.fromEntries(
  teamArchetypeRows.map((team) => [team.team_archetype, team.team_icon])
);

const relatedGuides = graphics.filter((graphic) => graphic.href !== Astro.url.pathname);
---

<Layout
  title={`${title} | Terminus Maximus Infographics`}
  description={description}
  image="https://terminusmaximus.com/images/web/ReplayLibraryBanner.webp"
  url="https://terminusmaximus.com/replay-library"
>
  <Header />

  <main>
    <section class="hero">
      <img
        src="/images/web/ReplayLibraryBanner.webp"
        alt="Replay Library"
        width="1200"
        height="592"
        class="hero-image"
      />
      <h1>{title}</h1>
      <p class="hero-tagline">{description}</p>
    </section>

    <ReplayStatistics />
    <ReplayLibraryFilters
      bosses={replayLibraryData.bosses}
      teams={replayLibraryData.teams}
      tiers={replayLibraryData.tiers}
    />
    <ReplayResultsTable />

    <section class="content-section replay-library-copy" aria-labelledby="about-replay-library-heading">
      <h2 id="about-replay-library-heading">About the Replay Library</h2>

      <p>
        The Replay Library is a searchable collection of real Guild Raid runs published by Tacticus players on YouTube.
        Each replay is cataloged by Boss, Map, Tier, Damage, Team Archetype, full Hero lineup, Machine of War, and Creator.
      </p>

      <p>
        <strong>The goal is simple:</strong> help you find replays that are relevant to the team you actually want to use.
      </p>

      <h3>How to Use the Replay Library</h3>

      <p>
        Start by selecting a <strong>Boss</strong>, then use the additional filters to narrow the results by:
      </p>

      <ul>
        <li><strong>Team</strong> to focus on an archetype such as Neuro, AdMech, or Laviscus.</li>
        <li><strong>Map</strong> to find runs for a specific Boss map</li>
        <li><strong>Tier</strong> to compare Legendary and Mythic difficulty runs.</li>
        <li><strong>Included Heroes</strong> to find replays using specific characters.</li>
        <li><strong>Excluded Heroes</strong> to find alternatives when you are missing a character.</li>
      </ul>

      <p>
        The statistics above the results update with your filters, while the replay table is sorted by damage. Click any
        result to watch the original YouTube replay.
      </p>

      <h3>Find Replays for the Team You Actually Have</h3>

      <p>The most useful question this library can answer is not always, "What is the best team?"</p>

      <p>Often, the better question is:</p>

      <p><strong>"Given the characters I have, what real replays can I watch?"</strong></p>

      <p>
        A top-performing team may include a character you have not unlocked or invested in. Use the Included and Excluded
        Hero filters to find alternate lineups built around your roster.
      </p>

      <p>
        The library does not promise that every lineup is optimal. It gives you evidence: real teams, real damage results,
        and a direct path to watch how each run was played.
      </p>

      <h3>How the Library Was Built</h3>

      <p>
        The Replay Library began as a personal analytics project for studying Guild Raid teams and understanding how the
        meta changes over time.
      </p>

      <p>
        Public Guild Raid videos from selected YouTube creators are collected, reviewed, and cataloged. The workflow
        combines simple automation with human review: coding scripts help find replay candidates, organize
        data, and prepare website files, while the replay data itself is reviewed and validated by me before entering the library.
      </p>

      <p>
        The same dataset also supports Boss Meta analysis, team comparisons, character usage, alternate lineup discovery,
        and future trend analysis.
      </p>

      <h3>Built From Community Replays</h3>

      <p>
        The Replay Library is possible because Tacticus creators take the time to record and publish their Guild Raid runs.
      </p>

      <p>
        The videos remain the work of their original creators and are never rehosted here. Every result links directly to
        the original YouTube video, making strong runs easier to discover and helping more players learn from the creators
        who produced them.
      </p>

      <p>
        As the library grows, the goal is to build a deeper evidence base for Guild Raid strategy across Bosses, Maps,
        Tiers, and roster variations. More replays, creators, and analysis will be added over time.
      </p>
    </section>


    <section class="content-section">
      <h2>Related Guides</h2>

      <div class="card-grid">
        {relatedGuides.map((graphic) => (
          <a class="card related-guide-card" href={graphic.href}>
            <div class="card-image-wrap">
              <img
                src={graphic.thumbnail}
                alt={`${graphic.title} preview`}
                class="card-image"
                loading="lazy"
              />
            </div>

            <div class="card-title-row">
              <h3>{graphic.title}</h3>
              {graphic.badge && <span class="card-badge">{graphic.badge}</span>}
            </div>
            <p>{graphic.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script define:vars={{ replayLibraryData, teamIconMap }}>
    const state = {
      boss: "",
      map: "",
      team: "",
      tier: "",
      minimumDamage: 0,
      minimumDate: "",
      includedHeroes: [],
      excludedHeroes: []
    };
    const sortState = {
      key: "damage",
      direction: "desc"
    };
    const tierSortRank = {
      M2: 0,
      M1: 1,
      L5: 2,
      L4: 3,
      L3: 4,
      L2: 5,
      L1: 6
    };

    const form = document.querySelector("[data-replay-filters]");
    const dependentFilters = Array.from(document.querySelectorAll("[data-dependent-filter]"));
    const sortButtons = Array.from(document.querySelectorAll("[data-sort-key]"));
    const sortHeaders = Array.from(document.querySelectorAll("[data-sort-header]"));
    const minimumDamageInput = document.querySelector('[data-filter="minimumDamage"]');
    const minimumDamageValue = document.querySelector("[data-minimum-damage-value]");
    const minimumDateInput = document.querySelector('[data-filter="minimumDate"]');
    const choiceToggles = {
      boss: document.querySelector('[data-choice-toggle="boss"]'),
      team: document.querySelector('[data-choice-toggle="team"]'),
      map: document.querySelector('[data-choice-toggle="map"]'),
      tier: document.querySelector('[data-choice-toggle="tier"]')
    };
    const choiceMenus = {
      boss: document.querySelector('[data-choice-menu="boss"]'),
      team: document.querySelector('[data-choice-menu="team"]'),
      map: document.querySelector('[data-choice-menu="map"]'),
      tier: document.querySelector('[data-choice-menu="tier"]')
    };
    const heroToggles = {
      includedHeroes: document.querySelector('[data-hero-toggle="includedHeroes"]'),
      excludedHeroes: document.querySelector('[data-hero-toggle="excludedHeroes"]')
    };
    const heroMenus = {
      includedHeroes: document.querySelector('[data-hero-menu="includedHeroes"]'),
      excludedHeroes: document.querySelector('[data-hero-menu="excludedHeroes"]')
    };
    const statisticsPanel = document.querySelector("[data-replay-statistics]");
    const resultsWrap = document.querySelector("[data-results-wrap]");
    const resultsBody = document.querySelector("[data-results-body]");
    const emptyState = document.querySelector("[data-empty-state]");

    const statElements = {
      matchingReplays: document.querySelector('[data-stat="matchingReplays"]'),
      highestDamage: document.querySelector('[data-stat="highestDamage"]'),
      averageDamage: document.querySelector('[data-stat="averageDamage"]'),
      uniqueCreators: document.querySelector('[data-stat="uniqueCreators"]'),
      uniqueMaps: document.querySelector('[data-stat="uniqueMaps"]')
    };
    const matchingReplayLabel = statElements.matchingReplays?.previousElementSibling;

    const escapeHtml = (value) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const getReplayIconPath = (type, value) => {
      const normalizedValue = type === "bosses" || type === "maps" ? value.replaceAll(" ", "_") : value;
      return `/images/replay-library/${type}/${normalizedValue}.webp`;
    };

    const iconHtml = (type, value, title = value, extraClass = "") => {
      if (!value) return "";
      const safeValue = escapeHtml(value);
      const safeTitle = escapeHtml(title);
      const src = escapeHtml(getReplayIconPath(type, value));
      const className = `replay-icon-wrap${extraClass ? ` ${extraClass}` : ""}`;

      return `
        <span class="${className}" data-icon-title="${safeTitle}">
          <img
            class="replay-icon"
            src="${src}"
            width="40"
            height="40"
            alt="${safeTitle}"
            title="${safeTitle}"
            loading="lazy"
            onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
          />
          <span class="icon-fallback" hidden>${safeValue}</span>
        </span>
      `;
    };

    const choiceIconHtml = (filterName, value, label = value) => {
      if (!value) {
        return '<span class="choice-icon choice-icon-empty" aria-hidden="true"></span>';
      }

      const type =
        filterName === "boss" ? "bosses" : filterName === "map" ? "maps" : filterName === "tier" ? "tier" : "heroes";
      const iconValue =
        filterName === "team" ? teamIconMap[value] || value : filterName === "tier" ? (value.startsWith("M") ? "mythic" : "legendary") : value;
      const src = escapeHtml(getReplayIconPath(type, iconValue));

      return `
        <img
          class="choice-icon"
          src="${src}"
          width="28"
          height="28"
          alt=""
          loading="lazy"
          onerror="this.hidden=true;"
        />
      `;
    };

    const selectedChoiceHtml = (filterName, value, placeholder, label = value) => {
      if (!value && filterName === "map") {
        return `
          <span class="choice-toggle-content">
            ${choiceIconHtml(filterName, "", placeholder)}
            <span>${escapeHtml(placeholder)}</span>
          </span>
        `;
      }
      if (!value) return `<span class="choice-placeholder">${escapeHtml(placeholder)}</span>`;
      return `
        <span class="choice-toggle-content">
          ${choiceIconHtml(filterName, value, label)}
          <span>${escapeHtml(label)}</span>
        </span>
      `;
    };

    const setChoiceValue = (filterName, value) => {
      const placeholder = {
        boss: "Select a Boss",
        team: "All Teams",
        map: "All Maps",
        tier: "All Tiers"
      }[filterName];
      const label = value || placeholder;

      choiceToggles[filterName].innerHTML = selectedChoiceHtml(filterName, value, placeholder, label);
      choiceMenus[filterName]
        .querySelectorAll("[data-choice-option]")
        .forEach((option) => {
          option.setAttribute("aria-selected", String(option.dataset.value === value));
        });
    };

    const renderChoiceMenu = (filterName, placeholder, options) => {
      choiceMenus[filterName].innerHTML = [
        `
          <button class="choice-option" type="button" data-choice-option="${filterName}" data-value="">
            ${choiceIconHtml(filterName, "", placeholder)}
            <span>${escapeHtml(placeholder)}</span>
          </button>
        `,
        ...options.map((option) => `
          <button class="choice-option" type="button" data-choice-option="${filterName}" data-value="${escapeHtml(option)}">
            ${choiceIconHtml(filterName, option)}
            <span>${escapeHtml(option)}</span>
          </button>
        `)
      ].join("");
      setChoiceValue(filterName, state[filterName] || "");
    };

    const closeChoiceMenu = (filterName) => {
      choiceMenus[filterName].hidden = true;
      choiceToggles[filterName].setAttribute("aria-expanded", "false");
    };

    const closeAllChoiceMenus = () => {
      Object.keys(choiceMenus).forEach(closeChoiceMenu);
    };

    const getHeroToggleText = (team, selectedCount) => {
      if (!team) return "Select a Team first";
      if (selectedCount === 0) return "Select all that apply";
      return `${selectedCount} selected`;
    };

    const formatFullDamage = (value) => (Number(value || 0) > 0 ? Number(value).toLocaleString() : "No floor");

    const parseDateFilterTimestamp = (value) => {
      if (!value) return 0;
      const timestamp = new Date(`${value}T00:00:00`).getTime();
      return Number.isFinite(timestamp) ? timestamp : 0;
    };

    const updateMinimumDamageLabel = () => {
      minimumDamageValue.textContent = formatFullDamage(state.minimumDamage);
    };

    const closeHeroMenu = (filterName) => {
      heroMenus[filterName].hidden = true;
      heroToggles[filterName].setAttribute("aria-expanded", "false");
    };

    const renderHeroMenu = (filterName, heroes, team) => {
      const selectedSet = new Set(state[filterName]);
      heroToggles[filterName].disabled = !team;
      heroToggles[filterName].textContent = getHeroToggleText(team, selectedSet.size);

      if (!team) {
        heroMenus[filterName].innerHTML = "<p>Select a Team first</p>";
        closeHeroMenu(filterName);
        return;
      }

      heroMenus[filterName].innerHTML = heroes
        .map((hero) => {
          const safeHero = escapeHtml(hero);
          const checked = selectedSet.has(hero) ? " checked" : "";
          return `
            <label class="hero-checkbox-option">
              <input type="checkbox" value="${safeHero}" data-hero-checkbox="${filterName}"${checked} />
              <span>${safeHero}</span>
            </label>
          `;
        })
        .join("");
    };

    const setHeroOptions = (team) => {
      const heroes = team ? replayLibraryData.heroesByTeam[team] || [] : [];
      renderHeroMenu("includedHeroes", heroes, team);
      renderHeroMenu("excludedHeroes", heroes, team);
    };

    const updateDependentFilters = () => {
      const hasBoss = Boolean(state.boss);
      dependentFilters.forEach((field) => {
        field.hidden = !hasBoss;
      });

      [choiceToggles.team, choiceToggles.tier, choiceToggles.map].forEach((field) => {
        field.disabled = !hasBoss;
      });

      if (!hasBoss) {
        state.map = "";
        state.team = "";
        state.tier = "";
        state.minimumDamage = 0;
        state.minimumDate = "";
        state.includedHeroes = [];
        state.excludedHeroes = [];
        minimumDamageInput.value = String(state.minimumDamage);
        minimumDateInput.value = "";
        updateMinimumDamageLabel();
        setChoiceValue("map", "");
        setChoiceValue("team", "");
        setChoiceValue("tier", "");
        setHeroOptions("");
        return;
      }

      const maps = replayLibraryData.mapsByBoss[state.boss] || [];
      renderChoiceMenu("map", "All Maps", maps);
      if (maps.includes(state.map)) {
        setChoiceValue("map", state.map);
      } else {
        state.map = "";
        setChoiceValue("map", "");
      }

      setChoiceValue("boss", state.boss);
      setChoiceValue("team", state.team);
      setChoiceValue("tier", state.tier);
      setHeroOptions(state.team);
    };

    const filterReplays = () => {
      if (!state.boss) return [];

      return replayLibraryData.replays.filter((replay) => {
        if (replay.boss !== state.boss) return false;
        if (state.team && replay.team !== state.team) return false;
        if (state.tier && replay.tier !== state.tier) return false;
        if (state.map && replay.map !== state.map) return false;
        if (replay.damage < state.minimumDamage) return false;
        if (state.minimumDate && replay.publishedAtTimestamp < parseDateFilterTimestamp(state.minimumDate)) return false;
        if (state.includedHeroes.some((hero) => !replay.heroes.includes(hero))) return false;
        if (state.excludedHeroes.some((hero) => replay.heroes.includes(hero))) return false;
        return true;
      });
    };

    const getSortValue = (replay, key) => {
      if (key === "damage") return replay.damage;
      if (key === "heroes") return replay.heroes.join(" ");
      if (key === "tier") return tierSortRank[replay.tier] ?? 99;
      if (key === "mow") return replay.mow || "";
      if (key === "publishedAt") return replay.publishedAtTimestamp || 0;
      return replay[key] || "";
    };

    const compareSortValues = (a, b, key) => {
      const aValue = getSortValue(a, key);
      const bValue = getSortValue(b, key);

      if (typeof aValue === "number" && typeof bValue === "number") {
        return aValue - bValue;
      }

      return String(aValue).localeCompare(String(bValue), undefined, {
        numeric: true,
        sensitivity: "base"
      });
    };

    const sortReplays = (replays) =>
      [...replays].sort((a, b) => {
        const comparison = compareSortValues(a, b, sortState.key);
        if (comparison !== 0) return sortState.direction === "asc" ? comparison : -comparison;
        return b.damage - a.damage;
      });

    const updateSortHeaders = () => {
      sortHeaders.forEach((header) => {
        const isActive = header.dataset.sortHeader === sortState.key;
        header.setAttribute(
          "aria-sort",
          isActive ? (sortState.direction === "asc" ? "ascending" : "descending") : "none"
        );
      });

      sortButtons.forEach((button) => {
        button.dataset.sortDirection = button.dataset.sortKey === sortState.key ? sortState.direction : "";
      });
    };

    const updateStatistics = (replays) => {
      if (!state.boss) {
        replays = replayLibraryData.replays;
        matchingReplayLabel.textContent = "Archived Replays";
      } else {
        matchingReplayLabel.textContent = "Matching Replays";
      }

      statisticsPanel.hidden = false;
      const count = replays.length;
      const highestReplay = count
        ? replays.reduce((highest, replay) => (replay.damage > highest.damage ? replay : highest), replays[0])
        : null;
      const averageDamage = count
        ? Math.round(replays.reduce((total, replay) => total + replay.damage, 0) / count)
        : 0;

      statElements.matchingReplays.textContent = count.toLocaleString();
      statElements.highestDamage.textContent = highestReplay ? highestReplay.damageLabel : "-";
      statElements.averageDamage.textContent = count ? formatDamage(averageDamage) : "-";
      statElements.uniqueCreators.textContent = new Set(replays.map((replay) => replay.creator)).size.toLocaleString();
      statElements.uniqueMaps.textContent = new Set(replays.map((replay) => replay.map)).size.toLocaleString();
    };

    const formatDamage = (value) => {
      if (value >= 1000000) return `${(value / 1000000).toFixed(2)}M`;
      if (value >= 1000) return `${Math.floor(value / 1000)}K`;
      return String(value);
    };

    const linkedCell = (replay, content) => `
      <td>
        <a
          class="replay-cell-link"
          href="${escapeHtml(replay.videoUrl)}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open ${escapeHtml(replay.creator)} replay on YouTube"
        >
          ${content}
        </a>
      </td>
    `;

    const plainCell = (content) => `
      <td>
        <span class="replay-cell-content">
          ${content}
        </span>
      </td>
    `;

    const youtubeLogoHtml = () => `
      <img
        class="youtube-logo"
        src="/images/replay-library/YTLogo.webp"
        width="28"
        height="20"
        alt="YouTube"
        loading="lazy"
      />
    `;

    const teamIconHtml = (team) => iconHtml("heroes", teamIconMap[team] || team, team, "labeled-icon-wrap");

    const mapIconHtml = (map) => {
      if (!map) return "";
      const safeMap = escapeHtml(map);
      const src = escapeHtml(getReplayIconPath("maps", map));

      return `
        <span class="map-preview-wrap">
          <img
            class="replay-icon map-icon"
            src="${src}"
            width="40"
            height="40"
            alt="${safeMap}"
            title="${safeMap}"
            loading="lazy"
            onerror="this.hidden=true; this.nextElementSibling.hidden=false;"
          />
          <span class="icon-fallback" hidden>${safeMap}</span>
          <span class="map-preview" aria-hidden="true">
            <img
              src="${src}"
              width="150"
              height="150"
              alt=""
              loading="lazy"
            />
          </span>
        </span>
      `;
    };

    const replayRowHtml = (replay) => `
      <tr
        class="replay-row"
        data-replay-url="${escapeHtml(replay.videoUrl)}"
      >
        ${plainCell(iconHtml("bosses", replay.boss, replay.boss, "labeled-icon-wrap"))}
        ${plainCell(teamIconHtml(replay.team))}
        ${linkedCell(replay, escapeHtml(replay.damageLabel))}
        ${linkedCell(replay, escapeHtml(replay.tier))}
        ${plainCell(mapIconHtml(replay.map))}
        ${plainCell(`<div class="hero-icons">${replay.heroes.map((hero) => iconHtml("heroes", hero, hero, "labeled-icon-wrap")).join("")}</div>`)}
        ${plainCell(iconHtml("mow", replay.mow, replay.mow, "labeled-icon-wrap"))}
        ${linkedCell(replay, youtubeLogoHtml())}
        ${linkedCell(replay, escapeHtml(replay.creator))}
        ${linkedCell(replay, `<span title="${escapeHtml(replay.publishedAt)}">${escapeHtml(replay.publishedAtLabel || "-")}</span>`)}
      </tr>
    `;

    const updateResults = (replays) => {
      if (!state.boss) {
        emptyState.textContent = "Select a Boss to begin exploring the Replay Library.";
        emptyState.hidden = false;
        resultsWrap.hidden = true;
        resultsBody.innerHTML = "";
        return;
      }

      if (replays.length === 0) {
        emptyState.textContent = "No matching replays found.";
        emptyState.hidden = false;
        resultsWrap.hidden = true;
        resultsBody.innerHTML = "";
        return;
      }

      emptyState.hidden = true;
      resultsWrap.hidden = false;
      resultsBody.innerHTML = replays.map(replayRowHtml).join("");
    };

    const render = () => {
      updateDependentFilters();
      const replays = sortReplays(filterReplays());
      updateSortHeaders();
      updateStatistics(replays);
      updateResults(replays);
    };

    form.addEventListener("input", (event) => {
      const minimumDamageField = event.target.closest('[data-filter="minimumDamage"]');
      if (minimumDamageField) {
        state.minimumDamage = Number(minimumDamageField.value) || 0;
        updateMinimumDamageLabel();
        render();
        return;
      }

      const minimumDateField = event.target.closest('[data-filter="minimumDate"]');
      if (minimumDateField) {
        state.minimumDate = minimumDateField.value;
        render();
        return;
      }

      const heroCheckbox = event.target.closest("[data-hero-checkbox]");

      if (heroCheckbox) {
        const filterName = heroCheckbox.dataset.heroCheckbox;
        const checkedHeroes = Array.from(
          heroMenus[filterName].querySelectorAll("[data-hero-checkbox]:checked")
        ).map((checkbox) => checkbox.value);
        state[filterName] = checkedHeroes;
        render();
        return;
      }

    });

    Object.entries(choiceToggles).forEach(([filterName, toggle]) => {
      toggle.addEventListener("click", () => {
        if (toggle.disabled) return;
        const willOpen = choiceMenus[filterName].hidden;
        closeAllChoiceMenus();
        Object.keys(heroMenus).forEach(closeHeroMenu);
        choiceMenus[filterName].hidden = !willOpen;
        toggle.setAttribute("aria-expanded", String(willOpen));
      });
    });

    form.addEventListener("click", (event) => {
      const option = event.target.closest("[data-choice-option]");
      if (!option) return;

      const filterName = option.dataset.choiceOption;
      state[filterName] = option.dataset.value || "";

      if (filterName === "boss") {
        state.map = "";
        state.tier = "";
        state.team = "";
        state.minimumDamage = 0;
        state.minimumDate = "";
        state.includedHeroes = [];
        state.excludedHeroes = [];
        minimumDamageInput.value = String(state.minimumDamage);
        minimumDateInput.value = "";
        updateMinimumDamageLabel();
      }

      if (filterName === "team") {
        state.includedHeroes = [];
        state.excludedHeroes = [];
      }

      closeAllChoiceMenus();
      render();
    });

    sortButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const sortKey = button.dataset.sortKey;
        if (!sortKey) return;

        if (sortState.key === sortKey) {
          sortState.direction = sortState.direction === "asc" ? "desc" : "asc";
        } else {
          sortState.key = sortKey;
          sortState.direction = sortKey === "damage" ? "desc" : "asc";
        }

        render();
      });
    });

    Object.entries(heroToggles).forEach(([filterName, toggle]) => {
      toggle.addEventListener("click", () => {
        if (toggle.disabled) return;
        const willOpen = heroMenus[filterName].hidden;
        closeAllChoiceMenus();
        Object.keys(heroMenus).forEach(closeHeroMenu);
        heroMenus[filterName].hidden = !willOpen;
        toggle.setAttribute("aria-expanded", String(willOpen));
      });
    });

    document.addEventListener("click", (event) => {
      if (event.target.closest(".hero-filter-field") || event.target.closest(".choice-filter-field")) return;
      Object.keys(heroMenus).forEach(closeHeroMenu);
      closeAllChoiceMenus();
    });

    const relatedCards = Array.from(document.querySelectorAll(".related-guide-card"));
    relatedCards
      .sort(() => Math.random() - 0.5)
      .forEach((card, index) => {
        card.style.display = index < 3 ? "block" : "none";
      });

    render();
  </script>

  <Footer />
</Layout>

