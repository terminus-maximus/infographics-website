---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const lreGuides = [
  {
    title: "Lucius -- Next LRE Event",
    description: "Coming July 26",
    href: "/lre/lucius",
    thumbnail: "/images/web/lucius-lre.webp",
  },
  {
    title: "Uthar LRE Guide",
    description: "Next to occur after Lucius, unless a new LRE is announced",
    href: "/lre/uthar",
    thumbnail: "/images/web/uthar-lre.webp",
  },
  {
    title: "Farsight LRE Guide",
    description: "Last seen June 2026, his 3rd event date is TBD",
    href: "/lre/farsight",
    thumbnail: "/images/web/farsight-lre.webp",
  },
];

const basics = [
  {
    title: "Event Goal",
    description:
      "Legendary Release Events are built around earning enough points to unlock the featured Legendary character. Progress carries over between appearances, so every clear matters even when an unlock will take more than one event cycle.",
  },
  {
    title: "Tracks and Requirements",
    description:
      "Each LRE is split into multiple battle tracks with different restrictions and scoring opportunities. Strong planning means matching teams to faction, damage type, trait, rarity, survival, and character limitations without wasting your best units too early.",
  },
  {
    title: "Team Planning",
    description:
      "The best LRE teams balance requirement coverage, durability, damage, and roster availability. Some teams stack several requirements at once, while others focus on one high-value requirement with characters that can reliably survive deeper stages.",
  },
  {
    title: "Long-Term Preparation",
    description:
      "LREs reward accounts that invest in flexible characters before the event begins. Healers, durable tanks, summoners, reusable damage dealers, and broadly useful support units often carry value across several Legendary Release Events.",
  },
];

const basicsIntro =
  "Legendary Release Events are some of the most demanding roster-check events in Tacticus. They reward long-term preparation, flexible characters, and careful team planning across multiple tracks rather than one perfect lineup.";
---

<Layout
  title="Legendary Release Events | Terminus Maximus Infographics"
  description="Legendary Release Event guides for unlock planning, team building, and event requirements."
  image="/images/web/lre.webp"
>
  <Header />

  <main>
  <section class="hero">
    <h1>Legendary Release Events</h1>
    <p>
      Legendary Release Event guides for unlock planning, team building, and event requirements.
    </p>
  </section>

  <section>
    <h2>LRE Guides</h2>

    <div class="card-grid">
      {lreGuides.map((guide) => (
        <a class="card" href={guide.href}>
          <div class="card-image-wrap">
            <img
              src={guide.thumbnail}
              alt={`${guide.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="content-section">
    <h2>LRE Basics</h2>

    <div class="markdown-content">
      <p class="section-intro">{basicsIntro}</p>

      {basics.map((item) => (
        <div class="basic-copy">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
    color: #cccccc;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    color: #d4af37;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

  .content-section {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .content-section h2 {
    margin-top: 0;
  }

  .markdown-content {
    color: #cccccc;
    line-height: 1.7;
  }

  .section-intro {
    max-width: 900px;
    margin: 0 0 1.5rem;
  }

  .basic-copy + .basic-copy {
    margin-top: 1.5rem;
  }

  .basic-copy h3 {
    color: #d4af37;
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .basic-copy p {
    margin: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
    gap: 1.5rem;
    justify-content: start;
  }

  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .content-section .card {
    background: #121212;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #d4af37;
    transform: translateY(-3px);
    outline: none;
  }

  .card-image-wrap {
    width: 100%;
    height: 120px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: #121212;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    display: block;
  }

  .card h3 {
    margin: 0 0 0.5rem;
    color: #d4af37;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card p {
    color: #cccccc;
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .content-section {
      padding: 1rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card {
      padding: 1rem;
    }

    .card-image-wrap {
      height: 110px;
    }
  }
</style>
