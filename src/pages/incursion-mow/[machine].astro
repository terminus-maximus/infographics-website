---
import IncursionGuidePage from "../../components/incursion/IncursionGuidePage.astro";
import { incursionGuides } from "../../data/incursion";
import { machines } from "../../lib/machines.mjs";
import type { Machine } from "../../lib/machine-types";
import type { IncursionGuide } from "../../data/incursion/types";

export function getStaticPaths() {
  return machines.map((machine) => ({ params: { machine: machine.slug }, props: { machine, guide: incursionGuides.find(guide => guide.slug === machine.slug) } }));
}

interface Props { machine: Machine; guide?: IncursionGuide }
const { machine, guide } = Astro.props;
---
<IncursionGuidePage machine={machine} guide={guide} />
