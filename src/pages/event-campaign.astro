---
import Layout from "../layouts/Layout.astro";

const target = "/campaign-event";
---

<Layout
  title="Campaign Event | Terminus Maximus Infographics"
  description="Redirecting to the Campaign Event guide."
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </Fragment>

  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>

  <p>
    Redirecting to <a href={target}>Campaign Event guide</a>...
  </p>
</Layout>
