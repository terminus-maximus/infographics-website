---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { graphics } from "../../data/graphics";
import { currentGuildRaidSeason } from "../../data/guildRaid";

const guildRaidGuides = [
  {
    title: currentGuildRaidSeason.title,
    description: `Guild Raid Season ${currentGuildRaidSeason.seasonNumber} boss lineups, maps, and recommended teams.`,
    href: currentGuildRaidSeason.href,
    thumbnail: currentGuildRaidSeason.webImage,
  },
  {
    title: "Boss Meta Guide",
    description: "Meta and alternate teams for every Guild Raid boss, backed by replay research.",
    href: "/guild-raid/boss-meta",
    thumbnail: "/images/web/boss-meta.webp",
    badge: "Popular",
  },
  {
    title: "Replay Library",
    description: "Searchable Guild Raid replay data organized by boss, map, team, tier, and damage.",
    href: "/replay-library",
    thumbnail: "/images/web/ReplayLibraryBanner.webp",
    badge: "New",
  },
  {
    title: "Season Archive",
    description: "Browse previous Guild Raid seasons, boss lineups, maps, and infographic archives.",
    href: "/guild-raid/archive",
    thumbnail: "/images/web/guild-raid-s103-mythic.webp",
  },
];

const basics = [
  {
    title: "What Are Guild Raids?",
    description:
      "Guild Raid is one of the core competitive and cooperative modes in Tacticus. Players spend raid tokens attacking rotating bosses across different maps and difficulty tiers, with each attack contributing damage toward guild progress and season rewards.",
  },
  {
    title: "Why Guild Raid Matters",
    description:
      "Guild Raid rewards steady account growth, strong roster planning, and efficient use of limited attacks. It is also one of the clearest places where character investment decisions show up: the right team can improve your results for many seasons, while a narrow or outdated build can slow progress for months.",
  },
  {
    title: "Investment Philosophy",
    description:
      "Guild Raid teams are expensive, so the goal is not to chase every showcase lineup. Prioritize characters and team archetypes that solve multiple bosses, overlap with other important game modes, and match the roster you can realistically build. Strong alternate teams are often more useful than a perfect meta team you cannot field.",
  },
  {
    title: "Using Evidence",
    description:
      "These guides lean on real replay data rather than isolated opinion. Use the Boss Meta Guide to understand which teams are performing well, the Replay Library to watch those teams in action, and the Current Season guide to prepare for the specific boss order, maps, and difficulties in front of your guild.",
  },
];

const relatedGuides = graphics.filter((graphic) => graphic.category !== "raid");
---

<Layout
  title="Guild Raid Guides | Terminus Maximus Infographics"
  description="Resources for maximizing Tacticus Guild Raid results"
  image={currentGuildRaidSeason.webImage}
>
  <Header />

  <main>
    <section class="hero">
      <h1>Guild Raid Guides</h1>
      <p>Resources for maximizing Tacticus Guild Raid results</p>
    </section>

    <section>
      <h2>Guild Raid Resources</h2>

      <div class="card-grid">
        {guildRaidGuides.map((guide) => (
          <a class="card" href={guide.href}>
            <div class="card-image-wrap">
              <img
                src={guide.thumbnail}
                alt={`${guide.title} preview`}
                class="card-image"
                loading="lazy"
              />
            </div>

            <div class="card-title-row">
              <h3>{guide.title}</h3>
              {guide.badge && <span class="card-badge">{guide.badge}</span>}
            </div>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Guild Raid Basics</h2>

      <div class="markdown-content">
        {basics.map((item) => (
          <div class="basic-copy">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Related Guides</h2>

      <div class="card-grid">
        {relatedGuides.map((graphic) => (
          <a class="card related-guide-card" href={graphic.href}>
            <div class="card-image-wrap">
              <img
                src={graphic.thumbnail}
                alt={`${graphic.title} preview`}
                class="card-image"
                loading="lazy"
              />
            </div>

            <div class="card-title-row">
              <h3>{graphic.title}</h3>
              {graphic.badge && <span class="card-badge">{graphic.badge}</span>}
            </div>
            <p>{graphic.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    const cards = Array.from(document.querySelectorAll(".related-guide-card"));

    cards
      .sort(() => Math.random() - 0.5)
      .forEach((card, index) => {
        card.style.display = index < 5 ? "block" : "none";
      });
  </script>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 760px;
    margin: 0 auto;
    color: #cccccc;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    color: #d4af37;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

  .content-section {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .markdown-content {
    color: #cccccc;
    line-height: 1.7;
  }

  .basic-copy + .basic-copy {
    margin-top: 1.5rem;
  }

  .basic-copy h3 {
    color: #d4af37;
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .basic-copy p {
    margin: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
    gap: 1.5rem;
    justify-content: start;
  }

  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .content-section .card {
    background: #121212;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #d4af37;
    transform: translateY(-3px);
    outline: none;
  }

  .card-image-wrap {
    width: 100%;
    height: 120px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: #121212;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    display: block;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card h3 {
    margin: 0;
    color: #d4af37;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(212, 175, 55, 0.7);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    background: rgba(212, 175, 55, 0.12);
    color: #f5d76e;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card p {
    color: #cccccc;
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .content-section {
      padding: 1rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card {
      padding: 1rem;
    }

    .card-image-wrap {
      height: 110px;
    }
  }
</style>
