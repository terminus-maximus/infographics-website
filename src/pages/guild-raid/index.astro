---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RequiredHeroIcons from "../../components/campaign/RequiredHeroIcons.astro";
import { graphics } from "../../data/graphics";
import { currentGuildRaidSeason } from "../../data/guildRaid";

const guildRaidGuides = [
  {
    title: currentGuildRaidSeason.title,
    description: `Guild Raid Season ${currentGuildRaidSeason.seasonNumber} boss lineups, maps, and recommended teams.`,
    href: currentGuildRaidSeason.href,
    thumbnail: currentGuildRaidSeason.webImage,
  },
  {
    title: "Boss Meta Guide",
    description: "Meta and alternate teams for every Guild Raid boss, backed by replay research.",
    href: "/guild-raid/boss-meta/",
    thumbnail: "/images/web/boss-meta.webp",
    badge: "Popular",
  },
  {
    title: "Replay Library",
    description: "Searchable Guild Raid replay data organized by boss, map, team, tier, and damage.",
    href: "/replay-library",
    thumbnail: "/images/web/ReplayLibraryBanner.webp",
  },
  {
    title: "Season Archive",
    description: "Browse previous Guild Raid seasons, boss lineups, maps, and infographic archives.",
    href: "/guild-raid/archive",
    thumbnail: "/images/web/guild-raid-s103-mythic.webp",
  },
];

const relatedGuides = graphics.filter((graphic) => graphic.category !== "raid");
---

<Layout
  title="Guild Raid Guides | Terminus Maximus Infographics"
  description="Resources for maximizing Tacticus Guild Raid results"
  image={currentGuildRaidSeason.webImage}
>
  <Header />

  <main>
    <section class="hero">
      <h1>Guild Raid Guides</h1>
      <p>Resources for maximizing Tacticus Guild Raid results</p>
    </section>

    <section>
      <h2>Guild Raid Resources</h2>

      <div class="card-grid">
        {guildRaidGuides.map((guide) => (
          <a class="card" href={guide.href}>
            <div class="card-image-wrap">
              <img
                src={guide.thumbnail}
                alt={`${guide.title} preview`}
                class="card-image"
                loading="lazy"
              />
            </div>

            <div class="card-title-row">
              <h3>{guide.title}</h3>
              {guide.badge && <span class="card-badge">{guide.badge}</span>}
            </div>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Guild Raid Basics</h2>

      <div class="markdown-content">
        <h3>Build Teams, Not Just Characters</h3>

        <p>
          Guild Raid is one of the most important team-building modes in Tacticus.
          Each season, your guild works together to defeat a rotating lineup of bosses
          across increasingly difficult tiers.
        </p>

        <p>
          Strong results come from more than upgrading your highest-damage character.
          The best Guild Raid teams combine characters that work together through:
        </p>

        <ul>
          <li>Damage and scaling</li>
          <li>Buffs and support</li>
          <li>Boss-specific mechanics</li>
          <li>Positioning and map strategy</li>
        </ul>

        <p>
          When deciding where to invest, think about the complete team you are building
          and which bosses that team can realistically fight.
        </p>

        <h3>Don't Chase Every Meta Team</h3>

        <p>
          Guild Raid characters are expensive to build. For most players, trying to
          build every top-performing team is neither realistic nor necessary.
        </p>

        <p>
          Instead, prioritize teams and characters that:
        </p>

        <ul>
          <li>Perform well against multiple bosses.</li>
          <li>Share characters with teams you already use.</li>
          <li>Provide value in other important game modes.</li>
          <li>Fit the roster and resources you can realistically develop.</li>
        </ul>

        <p>
          A strong team you can actually build is more valuable than a perfect meta
          team that will take months to finish.
        </p>

        <h3>Use Real Replays Before You Invest</h3>

        <p>
          Guild Raid strategy changes as new bosses, characters, and team combinations
          enter the game. These guides use real replay data to help you understand what
          teams are working and how players are using them.
        </p>

        <p>
          Use the <a href="/guild-raid/boss-meta/">Boss Meta Guide</a> to compare strong
          teams across bosses, the <a href="/replay-library">Replay Library</a> to watch
          those teams in action, and the Current Season guide to prepare for the bosses
          and maps your guild is facing now.
        </p>

        <p>
          Use these resources as a starting point, not a rulebook. Your best Guild Raid
          path depends on your roster, your guild's progression, and the teams you are
          already building.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>Related Guides</h2>

      <div class="card-grid">
        {relatedGuides.map((graphic) => (
          <a class="card related-guide-card" href={graphic.href}>
            <div class="card-image-wrap">
              <img
                src={graphic.thumbnail}
                alt={`${graphic.title} preview`}
                class="card-image"
                loading="lazy"
              />
            </div>

            <div class="card-title-row">
              <h3>{graphic.title}</h3>
              {graphic.badge && <span class="card-badge">{graphic.badge}</span>}
            </div>
            {graphic.requiredHeroes?.length ? (
              <RequiredHeroIcons heroes={graphic.requiredHeroes} />
            ) : (
              <p>{graphic.description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  </main>

  <script>
    const cards = Array.from(document.querySelectorAll(".related-guide-card"));

    cards
      .sort(() => Math.random() - 0.5)
      .forEach((card, index) => {
        card.style.display = index < 5 ? "block" : "none";
      });
  </script>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 760px;
    margin: 0 auto;
    color: #cccccc;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    color: #d4af37;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

.content-section {
  background: #1e1e1e;
  border: 1px solid #333;
  border-radius: 12px;
  padding: 1.5rem;
}

  .markdown-content {
    color: #cccccc;
    line-height: 1.7;
  }

  .markdown-content :global(a) {
    color: #d4af37;
  }

  .markdown-content :global(a:hover) {
    text-decoration: underline;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
    gap: 1.5rem;
    justify-content: start;
  }

  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .content-section .card {
    background: #121212;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #d4af37;
    transform: translateY(-3px);
    outline: none;
  }

  .card-image-wrap {
    width: 100%;
    height: 120px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: #121212;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    display: block;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card h3 {
    margin: 0;
    color: #d4af37;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(212, 175, 55, 0.7);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    background: rgba(212, 175, 55, 0.12);
    color: #f5d76e;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card p {
    color: #cccccc;
    line-height: 1.5;
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .content-section {
      padding: 1rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card {
      padding: 1rem;
    }

    .card-image-wrap {
      height: 110px;
    }
  }
</style>
