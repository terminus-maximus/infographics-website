---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RequiredHeroIcons from "../components/campaign/RequiredHeroIcons.astro";
import { discoveryGraphics } from "../data/graphics";

const startHere = discoveryGraphics.filter((g) => g.category === "start");
const campaignGuides = discoveryGraphics.filter(
  (g) =>
    g.category === "campaign" &&
    [
      "/campaigns/indomitus/",
      "/campaigns/indomitus-mirror/",
      "/campaigns/",
    ].includes(g.href),
);
const guildRaids = discoveryGraphics.filter(
  (g) => g.category === "raid" && g.href !== "/guild-raid/archive",
);
const legendaryGuides = discoveryGraphics.filter((g) => g.category === "legendary");
const gameEvents = discoveryGraphics.filter((g) => g.category === "event");
const aboutPages = discoveryGraphics.filter((g) => g.category === "about");
---

<Layout image="/images/web/TerminusMaximusInfographics.webp">
  <Header />

  <main>
<section class="hero">
  <img
    src="/images/web/TerminusMaximusInfographics.webp"
    alt="Terminus Maximus Infographics"
    width="1200"
    height="592"
    class="hero-image"
  />
  <p class="hero-tagline">
  The largest collection of Tacticus infographics from one of the game's most established creators.
  </p>
</section>

