---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { graphics } from "../data/graphics";

const startHere = graphics.filter((g) => g.category === "start");
const guildRaids = graphics.filter((g) => g.category === "raid");
const legendaryGuides = graphics.filter((g) => g.category === "legendary");
const gameEvents = graphics.filter((g) => g.category === "event");
const aboutPages = graphics.filter((g) => g.category === "about");
---

<Layout>
  <Header />

  <main>
<section class="hero">
  <img
    src="/images/TerminusMaximusInfographics.webp"
    alt="Terminus Maximus Infographics"
    width="1200"
    height="592"
    class="hero-image"
  />
  <p class="hero-tagline">
  The largest collection of Tacticus infographics from one of the game's most established creators.
  </p>
</section>

{/*
