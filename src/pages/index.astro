<section class="content-section">
  <header class="content-section-heading">
    <a href="/incursion-mow">
      <h2>New: Incursion MoW Guide</h2>
      <p>Choose your Machine of War on August 24</p>
    </a>
  </header>

  <a href="/incursion-mow" class="image-link">
    <img
      src="/images/web/incursion-mow.webp"
      alt="Incursion MoW Guide August 2026"
      class="infographic"
      loading="lazy"
    />
  </a>

  <p class="caption">
    <a href="/incursion-mow" class="caption-link">
