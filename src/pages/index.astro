  <section>
    <h2>New Player Guides</h2>

    <div class="card-grid">
      {startHere.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          {graphic.requiredHeroes?.length ? (
            <RequiredHeroIcons heroes={graphic.requiredHeroes} />
          ) : (
            <p>{graphic.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Campaign Guides</h2>

    <div class="card-grid">
      {campaignGuides.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          {graphic.requiredHeroes?.length ? (
            <RequiredHeroIcons heroes={graphic.requiredHeroes} />
          ) : (
            <p>{graphic.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Guild Raids</h2>

    <div class="card-grid">
      {guildRaids.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          <p>{graphic.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Legendary Guides</h2>

    <div class="card-grid">
      {legendaryGuides.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          <p>{graphic.description}</p>
        </a>
      ))}
    </div>
  </section>
  
  <section>
    <h2>Game Events</h2>

    <div class="card-grid">
      {gameEvents.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          <p>{graphic.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>About</h2>

    <div class="card-grid">
      {aboutPages.map((graphic) => (
        <a class="card" href={graphic.href}>
          <div class="card-image-wrap">
            <img
              src={graphic.thumbnail}
              alt={`${graphic.title} preview`}
              class="card-image"
              loading="lazy"
            />
          </div>

          <div class="card-title-row">
            <h3>{graphic.title}</h3>
          </div>
          <p>{graphic.description}</p>
        </a>
      ))}
    </div>
  </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(body) {
    background-color: #121212;
    color: #f5f5f5;
    font-family: 'Lexend', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
    color: #cccccc;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    color: #d4af37;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 320px));
    gap: 1.5rem;
    justify-content: start;
  }

  .card {
    background: #1e1e1e;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #d4af37;
    transform: translateY(-3px);
    outline: none;
  }

  .card-image-wrap {
    width: 100%;
    height: 120px;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1rem;
    background: #121212;
    border: 1px solid #333;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
    display: block;
  }

  .card-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card h3 {
    margin: 0;
    color: #d4af37;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .card p {
    color: #cccccc;
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Mobile refinements */
  @media (max-width: 700px) {
    main {
      padding: 1.25rem;
    }

    .hero {
      margin-bottom: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .card {
      padding: 1rem;
    }

    .card-image-wrap {
      height: 110px;
    }
  }
  .hero {
  text-align: center;
  margin-bottom: 3rem;
}

.hero-image {
  width: 100%;
  max-width: 600px;
  height: auto;
  border-radius: 12px;
  display: block;
  margin: 0 auto 1.5rem auto;
}

.hero h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.hero-tagline {
  font-size: 1.2rem;
  color: #cccccc;
  max-width: 800px;
  margin: 0 auto 5rem auto;
  line-height: 1.5;
}

.content-section {
  background: #1e1e1e;
  border: 1px solid #333;
  border-radius: 12px;
  padding: 1.5rem;
  margin-top: 2rem;
  margin-bottom: 4rem;
}

.content-section h2 {
  text-align: left;
}

.content-section-heading {
  padding-bottom: 0.75rem;
  margin-bottom: 1rem;
  border-bottom: 1px solid #333;
  text-align: left;
}

.content-section-heading a {
  display: block;
  color: inherit;
  text-decoration: none;
}

.content-section-heading a:hover h2,
.content-section-heading a:focus-visible h2 {
  color: #f5d76e;
  text-decoration: underline;
}

.content-section-heading a:focus-visible {
  border-radius: 4px;
  outline: 2px solid #d4af37;
  outline-offset: 4px;
}

.content-section-heading h2 {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: 0;
}

.content-section-heading p {
  margin: 0.35rem 0 0;
  color: #e0e0e0;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.5;
}

.whats-new-list {
  color: #cccccc;
  line-height: 1.8;
  padding-left: 1.25rem;
  text-align: left;
}

.whats-new-list li {
  margin-bottom: 0.75rem;
}

.whats-new-list a {
  color: #d4af37;
  text-decoration: none;
}

.whats-new-list a:hover {
  text-decoration: underline;
}
.image-link {
  display: block;
  text-align: center;
}
.infographic {
  max-width: 600px;
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
  margin: 0 auto;
}

.caption {
  text-align: center;
  margin: 1rem 0 0;
}

.caption-link {
  color: #d4af37;
  font-family: 'Lexend', sans-serif;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-decoration: none;
  transition: color 0.2s ease;
}

.caption-link:hover,
.caption-link:focus-visible {
  color: #f5d76e;
  text-decoration: underline;
}
</style>
