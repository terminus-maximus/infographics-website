  <a href="/lre/lysander" class="image-link">
    <img
      src="/images/web/lysander-lre.webp"
      alt="Lysander LRE Guide"
      class="infographic"
      loading="lazy"
    />
  </a>

  <p class="caption">
    <a href="/lre/lysander" class="caption-link">
      LEARN MORE
    </a>
  </p>
</section>

