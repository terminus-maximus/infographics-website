---
const {
	title = "Terminus Maximus Infographics",
	description = "Tacticus infographics, strategy guides, Guild Raid resources, and Legendary Event planning.",
	image = "https://terminusmaximus.com/images/TerminusMaximusInfographics.png",
	url = "https://terminusmaximus.com/"
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-9K17FDPZKJ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-9K17FDPZKJ');
		</script>
		<script is:inline>
			document.addEventListener("click", (event) => {
				const target = event.target;

				if (!(target instanceof Element)) return;

				const infographicLink = target.closest("[data-ga4-infographic-open]");

				if (infographicLink && typeof gtag === "function") {
					gtag("event", "full_resolution_infographic_open", {
						infographic_title: infographicLink.dataset.ga4InfographicTitle || document.title,
						infographic_url: infographicLink.href,
						link_source: infographicLink.dataset.ga4LinkSource || infographicLink.textContent.trim() || "image",
						page_path: window.location.pathname
					});
				}

				const youtubeLink = target.closest("a[href]");

				if (!youtubeLink || typeof gtag !== "function") return;
				if (!window.location.pathname.startsWith("/guild-raid")) return;

				const linkUrl = new URL(youtubeLink.href);
				const youtubeHosts = ["youtube.com", "www.youtube.com", "m.youtube.com", "youtu.be"];

				if (!youtubeHosts.includes(linkUrl.hostname)) return;

				gtag("event", "guild_raid_youtube_click", {
					link_url: youtubeLink.href,
					link_text: youtubeLink.textContent.trim(),
					link_host: linkUrl.hostname,
					page_path: window.location.pathname,
					page_title: document.title
				});
			});
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="icon" type="image/png" href="/favicon.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:url" content={url} />
		<meta property="og:type" content="website" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
